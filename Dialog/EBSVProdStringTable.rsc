		//buildings
		{ String _name = "EBSVTannery";									String _text = "Curtume da Vila";	}
		{ String _name = "EBSVTanneryLwr";								String _text = "curtume da vila";	}
		{ String _name = "EBSVTanneryTip";								String _text = "O Curtume da Vila produz Couro Curtido. 1 Curtidor pode ser empregado para produzir 1 Couro Curtido a partir de 1 Couro, 1 Água e 3 Sal. Ciclos de Construção: 50. 2 Variações de Cor com Tecla F.";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "Mina de Sal da Vila";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "mina de sal da vila";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "A Mina de Sal da Vila extrai Sal de um veio de sal. Até 2 Trabalhadores podem ser empregados para extrair e processar o Sal. Produzindo: 8 a 12 de Sal. Ciclos de Construção: 52. 2 Variações de Cor com Tecla F."; }
		
		{ String _name = "EBSVWaterWell";								String _text = "Poço de Água da Vila";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "poço de água da vila";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "O Poço de Água da Vila contém água. 1 Trabalhador pode ser empregado para coletar de 12 a 16 de Água do Poço. Ciclos de Construção: 42. 2 Variações de Cor com Tecla F."; }
		
		{ String _name = "EBSVShoemaker";								String _text = "Sapataria da Vila";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "sapataria da vila";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "A Sapataria da Vila produz Sapatos. 1 Sapateiro pode ser empregado para produzir vários tipos de sapatos a partir de Couro, Óleo de Linhaça e Couro Curtido. Ciclos de Construção: 50. 2 Variações de Cor com Tecla F.";  }
		
		{ String _name = "EBSVOilPress";								String _text = "Prensa de Óleo da Vila";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "prensa de óleo da vila";	}
		{ String _name = "EBSVOilPressTip";								String _text = "A Prensa de Óleo da Vila produz de 14 a 18 de Óleo Vegetal a partir de 25 Grãos e 1 Ânfora, de 14 a 18 de Óleo de Sementes a partir de 25 Pecã, ou 25 Noz e 1 Ânfora, ou de 14 a 18 de Óleo de Linhaça a partir de 25 Linho e 1 Ânfora. Até 2 Prensadores podem ser empregados para produzir de 18 a 24 de Óleo de Sementes a partir de Pecã ou Noz, produzir de 18 a 24 de Óleo Vegetal a partir de 50 Grãos, produzir de 18 a 24 de Óleo de Linhaça a partir de 50 Linho. Ciclos de Construção: 48. 2 Variações de Cor com Tecla F."; }
		
		{ String _name = "EBSVSandPit";									String _text = "Cava de Areia da Vila"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "cava de areia da vila"; }
		{ String _name = "EBSVSandPitTip";								String _text = "A Cava de Areia da Vila produz Areia. Até 3 Trabalhadores podem ser empregados para produzir de 5 a 7 de Areia. Ciclos de Construção: 36. 2 Variações de Cor com Tecla F."; }
		
		{ String _name = "EBSVPottery";									String _text = "Olaria da Vila";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "olaria da vila";	}
		{ String _name = "EBSVPotteryTip";								String _text = "A Olaria da Vila produz Ânforas. 1 Oleiro pode ser empregado para produzir de 3 a 4 Ânforas a partir de 4 de Argila e 1 de Carvão Mineral ou 1 de Carvão Vegetal. Ciclos de Construção: 50. 2 Variações de Cor com Tecla F.";  }
		
		{ String _name = "EBSVKiln";									String _text = "Forno da Vila";	}
