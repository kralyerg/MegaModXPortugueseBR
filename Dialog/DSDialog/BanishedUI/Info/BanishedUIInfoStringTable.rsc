			String _text = "25";
		}
		{
			String _name = "column2text01cBronze";
			String _text = "Bronze";
		}
		{
			String _name = "Bronze00Tip";
			String _text = "O Bronze é produzido sob o limite de Metais, Ligas e forjados para controlar a produção. É utilizado em ferramentas e na construção de edifícios.";
		}
		{
			String _name = "column2text02cBronze";
			String _text = "7 Minério de Cobre + ";
		}
		{
			String _name = "Bronze01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 47-49 (Carvão-Coque). Trabalhadores Não Instruídos obterão um lucro de 11-13, pois apenas 1 unidade de Bronze será produzida; enquanto um trabalhador Instruído obterá um lucro total de 41-43 (Coque-Carvão) ou 13,67-14,33 por unidade de Bronze.";
		}
		{
			String _name = "column2text04cBronze";
			String _text = "1 Minério de Estanho + ";
		}
		{
			String _name = "BronzeQty";
			String _text = "Produção: 2-3";
		}
		{
			String _name = "BronzeValue";
