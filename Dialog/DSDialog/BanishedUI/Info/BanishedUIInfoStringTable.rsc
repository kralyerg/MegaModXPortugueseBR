StringTable InfoPotteryGlass
{
	Entry _strings
	[
		{
			String _name = "PotteryGlass";
			String _text = "Cerâmica e Vidro";
		}
		{
			String _name = "PotteryGlassTitle1";
			String _text = "Cerâmica, Tijolos, Telhas e Fabricação de Vidro";
		}
		{
			String _name = "PotteryGlassTitle2";
			String _text = "- dos materiais brutos da terra, como recipientes e vidro de qualidade -";
		}
		{
			String _name = "column1text01";
			String _text = "A Cerâmica é um importante bem manufaturado e utensílio, usado na vida cotidiana pelos cidadãos. Como muitos objetos diferentes: uma simples lâmpada, é usada como item essencial de construção (particularmente em minas), e como recipientes para misturar, armazenar e conservar itens.";
		}
		{
			String _name = "column1text02";
			String _text = "Não há como negar a importância do uso de Tijolos e Telhas na construção de edifícios. Na maioria dos casos, são mais leves e mais duráveis do que seus equivalentes de pedra, madeira e colmo. E quando usados na construção de residências, aumentarão e proporcionarão melhor aquecimento e retenção de calor.";
		}
		{
			String _name = "column1text03";
			String _text = "O Vidro é uma criação maravilhosa; o vidro de qualidade, do tipo usado para janelas em edifícios, tem muitos benefícios: ao deixar entrar mais luz, permite que as casas usem menos combustível, pois não vivemos mais em casebres de pedra escuros e úmidos. Útil em edifícios de produção, mais luz permite que o trabalho seja realizado mais rápido e com melhor qualidade.";
		}
		{
			String _name = "column1text04";
			String _text = "Os Utensílios de Vidro, assim como a cerâmica, são feitos e usados como recipientes para misturar e armazenar itens, sendo também usados por uma Afinaria para produzir Amuletos.";
		}
		{
			String _name = "column1text05";
			String _text = "Mostrando ainda mais os incríveis usos do material: a Cal; também pode ser usada na produção de cerâmica e vidro. Na produção de Cerâmica, junto com a Areia, substitui a argila na receita. Na produção de vidro, atua de forma muito semelhante, sendo um ligante para um vidro mais forte, mas também permite o uso de menos Areia.";
		}
		{
			String _name = "column2AreMadeFrom";
			String _text = "são feitos de:";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "é feito de:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou:";
		}
		{
			String _name = "valueTip";
			String _text = "Valor do produto";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valor do produto, este produto tem um valor flutuante; como tal, os mercadores podem oferecer ou comprar a um preço dentro desta faixa";
		}
		{
			String _name = "weightTip";
			String _text = "Peso do produto";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantidade de produto produzido por trabalhadores instruídos ou não instruídos";
		}
		{
			String _name = "column2text01";
			String _text = "Cerâmica";
		}
		{
			String _name = "Pottery00Tip";
			String _text = "Um bem manufaturado amplamente utilizado, a Cerâmica oferece muitas funções para os cidadãos na produção e construção. Usa o limite de Bens Manufaturados e Utensílios para controlar a produção.";
		}
		{
			String _name = "column2text02";
			String _text = "4 Argila + ";
		}
		{
