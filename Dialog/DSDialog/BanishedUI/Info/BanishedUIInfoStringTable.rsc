StringTable InfoMiningSmelting
{
	Entry _strings
	[
		{
			String _name = "MiningSmelting";
			String _text = "Mineração e Fundição";
		}
		{
			String _name = "MiningSmeltingTitle1";
			String _text = "Mineração, Ensaio e Metalurgia";
		}
		{
			String _name = "MiningSmeltingTitle2";
			String _text = "- dos minérios, minerais, pedra e materiais brutos da terra -";
		}
		{
			String _name = "MiningSmeltingTitle3";
			String _text = "- e dos combustíveis e fundentes para a metalurgia -";
		}
		{
			String _name = "column1text01";
			String _text = "O Ferro, isto é, o ferro nativo puro, se é que existe algum a ser encontrado no reino mineral, é de fato de extrema escassez. Ele não está mais disponível como um metal minerado ou colhido na superfície. Em vez disso, o Minério de Ferro é extraído; principalmente está disponível em minas, mas também há uma pequena quantidade finita do minério que pode ser encontrada na superfície do mapa no início de um jogo. Esta é uma mudança realista no processo de produção do Ferro.";
		}
		{
			String _name = "column1text01a";
			String _text = "A Mineração (e o Corte de Pedra) é caracteristicamente uma ocupação perigosa no jogo, o que agora é reduzido em certo grau por um custo extra. A mineração é cara, exigindo no mínimo o custo de uma tora ou pedaço de madeira serrada a cada ciclo. Minas mais profundas e maiores também podem exigir óleo de lamparina ou velas para operar.";
		}
		{
			String _name = "column1text01b";
			String _text = "Embora a pedra possa ser retirada da superfície por qualquer Trabalhador com ferramentas normais, a pedra extraída de pedreiras agora exigirá o uso de utensílios especializados a cada ciclo: 'Ferramentas:Pedreiro', um bem manufaturado e utensílio, feito em ferrarias. Assim como com os Mineiros, os Cortadores de Pedra agora também têm uma probabilidade reduzida de morte ocupacional.";
		}
		{
			String _name = "column1text02";
			String _text = "O Minério de Ferro precisa ser fundido em um forno muito quente para remover impurezas e ser transformado no mais rígido dos metais: o Ferro.";
		}
		{
			String _name = "column1text02a";
			String _text = "Minério de Ferro";
		}
		{
			String _name = "column1text02b";
			String _text = "Em sua maioria minerado, embora uma pequena quantidade seja encontrada na superfície. O minério de ferro não tem forma certa; sendo totalmente irregular, na maioria das vezes de coloração enferrujada. É essa cor que denuncia a quantidade de Ferro que contém, sendo o mais fusível dos minérios de ferro.";
		}
		{
			String _name = "column1text02c";
			String _text = "Extraído em quantidades de 3-5 Minério de Ferro.";
		}
		{
			String _name = "column1text02copper";
			String _text = "O Minério de Cobre também precisa de um forno de grande calor para ser fundido em uma forma metálica sólida de Cobre.";
		}
		{
			String _name = "column1text02coppera";
			String _text = "Minério de Cobre";
		}
		{
			String _name = "column1text02copperb";
			String _text = "Em sua maioria minerado, embora uma grande quantidade possa ser encontrada na superfície. O minério de cobre, às vezes quando recém-minerado, é da mais escura cor vermelho-azulada, mas antes mesmo de alcançar a superfície, oxida-se e adquire as mais belas cores de azul e verde.";
		}
		{
			String _name = "column1text02copperc";
			String _text = "Extraído em ciclos de 3-5 Minério de Cobre.";
		}
		{
			String _name = "column1text02tin";
			String _text = "O Minério de Estanho precisará de um forno para ser fundido em uma forma metálica sólida de Estanho, embora também seja usado junto com o Minério de Cobre para forjar Bronze.";
		}
		{
			String _name = "column1text02tina";
			String _text = "Minério de Estanho";
		}
		{
			String _name = "column1text02tinb";
			String _text = "Minerado, embora quantidades sejam encontradas na superfície. O minério de estanho mais rico é de cor preta ou escura, de forma poliédrica, mas totalmente irregular, sendo sua superfície muitas vezes bastante brilhante. Comumente pode ser encontrado em depósitos aluviais ao longo das margens de rios.";
		}
		{
			String _name = "column1text02tinc";
			String _text = "Extraído em ciclos de 3-5 Minério de Estanho.";
		}
		{
			String _name = "column1text03";
			String _text = "O Minério de Prata também precisa ser fundido, mas a uma temperatura mais baixa e lenta dentro de um forno de afinação, para extrair a Prata propriamente dita.";
		}
		{
			String _name = "column1text02silvera";
			String _text = "Minério de Prata";
		}
		{
			String _name = "column1text02silverb";
			String _text = "O minério de prata é apenas minerado, e embora às vezes seja encontrado em sua forma mais pura e nativa, considerá-lo de tal valor é vão. Pois certamente contém enxofre e arsênico. Como tal, toda a prata de uma mina deve ser fundida junto com os minérios menos puros.";
		}
		{
			String _name = "column1text02silverc";
			String _text = "Extraído em ciclos de 3-5 Minério de Prata.";
		}
		{
			String _name = "column1text03Gold1";
			String _text = "O Ouro; de todos os outros metais, é o mais frequentemente encontrado em estado nativo, livre de enxofre e arsênico. Não conheço nenhum minério em que o Ouro constitua a maior parte metálica. De fato, existem vários minérios vendidos sob esse título, mas sob exame rigoroso, verifica-se que não o são. Já aconteceu de muitas pessoas, enganadas pela cor avermelhado-amarelada desses minérios, parecendo que havia Ouro neles, tomá-los por minérios de ouro. Mas nunca vi ninguém enriquecer por meio deles, ou do pouco ouro que possa ser fundido a partir deles.";
		}
		{
			String _name = "column1text04";
			String _text = "Para deixar o forno ou a forja de um ferreiro quente o suficiente para fundir e extrair minérios, são necessários combustíveis que possam queimar a uma temperatura mais alta e por mais tempo do que a lenha ou o carvão (ambos têm muitas impurezas, queimam de forma irregular e rápida demais). O uso de um Combustível Metalúrgico agora é essencial em todos os elementos da metalurgia:";
		}
		{
			String _name = "column1text05";
			String _text = "Carvão";
		}
		{
			String _name = "column1text05a";
			String _text = "Um produto de toras, o Carvão é feito de forma primitiva em uma pilha de carvão, ou em um forno de carvão (em breve).";
		}
		{
			String _name = "column1text05b";
			String _text = "As toras são aquecidas na ausência de oxigênio, a pirólise ou carbonização começa, isso remove as impurezas e, a partir disso, aproximadamente 34-55 Carvão são produzidos a cada 21 Toras utilizadas.";
		}
		{
			String _name = "column1text06";
			String _text = "Coque";
		}
		{
			String _name = "column1text06a";
			String _text = "Um produto do carvão mineral, o Coque é 'cozido', muito parecido com o carvão vegetal; de forma primitiva em uma pilha de carvão (em breve), onde o carvão é empilhado e coberto com terra, ou em um forno de coque em formato de colmeia, sendo produzido mais rapidamente.";
		}
		{
			String _name = "column1text06b";
			String _text = "O processo requer 21 unidades de Carvão minerado para produzir aproximadamente 21-34 Coque.";
		}
		{
			String _name = "column1text08";
			String _text = "A forja de metais é rápida e realizada sob condições muito quentes, o que significa que frequentemente há muito desperdício na quantidade de minério usado em relação ao que é finalmente produzido.";
		}
		{
			String _name = "column1text09";
			String _text = "A introdução de um fundente em um forno junto com o minério e o combustível permite que metade da quantidade de minério seja usada, mantendo ainda a mesma produção:";
		}
		{
			String _name = "column1text10";
			String _text = "Cal (também conhecida como Cal Virgem)";
		}
		{
			String _name = "column1text10a";
			String _text = "Produzida em um forno de forma semelhante a um forno de coque, a Cal é o produto de Pedra mais macia (com mais cálcio). A pedra é empilhada em um forno onde é aquecida com um combustível até reagir e se tornar um pó branco-acinzentado.";
		}
		{
			String _name = "column1text10b";
			String _text = "Um único pedaço grande de Pedra, com a adição de um combustível, provavelmente produzirá aproximadamente 5-8 de Cal.";
		}
		{
			String _name = "column1text10c";
			String _text = "O uso da Cal no forno ao fundir metais reage com os minérios, ajudando a separar as impurezas. A Cal também é usada como material de construção, atuando como um ligante forte e também aumentando o isolamento térmico de um edifício.";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "é feito de:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou:";
		}
		{
			String _name = "valueTip";
			String _text = "Valor do produto";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valor do produto, este produto tem um valor flutuante; como tal, os mercadores podem oferecer ou comprar a um preço dentro desta faixa";
		}
		{
			String _name = "weightTip";
			String _text = "Peso do produto";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantidade de produto produzido por trabalhadores instruídos ou não instruídos";
		}
		{
			String _name = "column2text01";
			String _text = "Ferro";
		}
		{
			String _name = "Iron00Tip";
			String _text = "O mais comum e utilizado de todos os metais, o Ferro tem seu próprio limite para controlar a produção. Utilizado de forma importante como material para produzir Ferramentas, também é usado na construção de edifícios.";
		}
		{
			String _name = "column2text02";
			String _text = "5 Minério de Ferro + ";
		}
		{
			String _name = "column2text03";
			String _text = "2 Coque ou Carvão";
		}
		{
			String _name = "Iron01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 34-36 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 2 com coque, ou ficarão no zero a zero com carvão, pois apenas 1 unidade de Ferro será produzida; enquanto um trabalhador Instruído obterá um lucro total de 32-34 (Coque-Carvão) ou 16-17 por unidade de Ferro.";
		}
		{
			String _name = "column2text04";
			String _text = "3 Minério de Ferro + ";
		}
		{
			String _name = "column2text05";
			String _text = "1 Cal + ";
		}
		{
			String _name = "column2text06";
			String _text = "2 Coque ou Carvão";
		}
		{
			String _name = "Iron02Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 31-33 (Carvão-Coque). Trabalhadores Não Instruídos obterão um lucro de 1-3 (Coque-Carvão), pois apenas 1 unidade de Ferro será produzida; enquanto um trabalhador Instruído obterá um lucro total de 35-37 ou 17,5-18,5 por unidade de Ferro. Assim como o Coque está para o Carvão, a Cal é potencialmente um material mais barato de produzir do que o Minério de Ferro, portanto os lucros totais de ponta a ponta provavelmente serão maiores.";
		}
		{
			String _name = "IronQty";
			String _text = "Produção: 1-2";
		}
		{
			String _name = "IronValue";
			String _text = "34";
		}
		{
			String _name = "IronWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01c";
			String _text = "Cobre";
		}
		{
			String _name = "Copper00Tip";
			String _text = "O Cobre é produzido sob o limite de Metais, Ligas e forjados para controlar a produção. Seus usos são principalmente na construção de edifícios, embora também possa ser usado para fazer Ferramentas e outros utensílios de cobre.";
		}
		{
			String _name = "column2text02c";
			String _text = "5 Minério de Cobre + ";
		}
		{
			String _name = "Copper01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 34-36 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 4-6, pois apenas 1 unidade de Cobre será produzida; enquanto um trabalhador Instruído obterá um lucro total de 24-26 (Coque-Carvão) ou 12-13 por unidade de Cobre.";
		}
		{
			String _name = "column2text04c";
			String _text = "3 Minério de Cobre + ";
		}
		{
			String _name = "Copper02Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 31-33 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 1-3, pois apenas 1 unidade de Cobre será produzida; enquanto um trabalhador Instruído obterá um lucro total de 27-29 (Coque-Carvão) ou 13,5-14,5 por unidade de Cobre. Assim como o Coque está para o Carvão, a Cal é potencialmente um material mais barato de produzir do que o Minério de Cobre, portanto os lucros totais de ponta a ponta provavelmente serão maiores.";
		}
		{
			String _name = "CopperQty";
			String _text = "Produção: 1-2";
		}
		{
			String _name = "CopperValue";
			String _text = "30";
		}
		{
			String _name = "CopperWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cTin";
			String _text = "Estanho";
		}
		{
			String _name = "Tin00Tip";
			String _text = "O Estanho é produzido sob o limite de Metais, Ligas e forjados para controlar a produção. É utilizado na fabricação de Utensílios de Estanho e como um bem valioso no comércio.";
		}
		{
			String _name = "column2text02cTin";
			String _text = "5 Minério de Estanho + ";
		}
		{
			String _name = "Tin01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 39-41 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 3-5, pois apenas 1 unidade de Estanho será produzida; enquanto um trabalhador Instruído obterá um lucro total de 31-33 (Coque-Carvão) ou 15,5-16,5 por unidade de Estanho.";
		}
		{
			String _name = "column2text04cTin";
			String _text = "3 Minério de Estanho + ";
		}
		{
			String _name = "Tin02Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 34-36 (Carvão-Coque). Trabalhadores Não Instruídos ficarão no zero a zero com coque, ou terão um lucro de 2 com carvão; enquanto um trabalhador Instruído obterá um lucro total de 36-38 (Coque-Carvão) ou 18-19 por unidade de Estanho. Assim como o Coque está para o Carvão, a Cal é potencialmente um material mais barato de produzir do que o Minério de Estanho, portanto os lucros totais de ponta a ponta provavelmente serão maiores.";
		}
		{
			String _name = "TinQty";
