StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "Saúde & Felicidade";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "Saúde & Felicidade";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "- das doenças e males que acometem os aldeões, e de sua felicidade e depressão -";
		}
		{
			String _name = "column1text01";
			String _text = "Saúde e Felicidade em Banished são exibidas ao jogador através do uso de ícones (veja à direita), mostradas como uma estatística média da cidade, ou individualmente ao selecionar e visualizar a interface de um cidadão.";
		}
		{
			String _name = "column1text02";
			String _text = "Ao jogar Banished, às vezes pode ser fácil ter uma vila com corações ou estrelas cheios (para os níveis de Saúde ou Felicidade, respectivamente).";
		}
		{
			String _name = "column1text03";
			String _text = "Mas ao usar os mods DS*, os cidadãos serão influenciados com mais frequência, e em maior grau, pelo que os torna doentes e infelizes. Isso proporciona ao jogador uma experiência de jogo mais desafiadora e interativa.";
		}
		{
			String _name = "column1text04";
			String _text = "*(isso só terá efeito quando certos mods DS forem colocados acima de outros mods que também possam alterar o arquivo de cidadãos).";
		}
		{
			String _name = "column1text05";
			String _text = "Agora se torna necessário garantir que a nutrição adequada, as necessidades espirituais e outras sejam supridas aos cidadãos, além de dar maior importância ao planejamento urbano para combater os influenciadores negativos de felicidade.";
		}
		{
			String _name = "column1text06";
			String _text = "Doenças e Enfermidades";
		}
		{
			String _name = "column1text07";
			String _text = "Junto com as mudanças na saúde e felicidade dos cidadãos, há mudanças";
		}
		{
			String _name = "column1text07add";
			String _text = "na probabilidade e nos tipos de doenças que os cidadãos podem adquirir. Quando um cidadão é acometido por qualquer uma delas, ele precisará dos cuidados de um Hospital e de um Médico.";
		}
		{
			String _name = "column1text08";
			String _text = "uma lista das enfermidades, doenças e males:";
		}
		{
			String _name = "column1text09";
			String _text = "Apoplexia (derrame)";
		}
		{
			String _name = "column1text10";
			String _text = "Atrofia (perda muscular)";
		}
		{
			String _name = "column1text11";
			String _text = "Biliosidade";
		}
		{
			String _name = "column1text12";
			String _text = "Febre Negra (parasitária)";
		}
		{
			String _name = "column1text13";
			String _text = "Septicemia (sepse)";
		}
		{
			String _name = "column1text14";
			String _text = "Osso Quebrado";
		}
		{
			String _name = "column1text15";
			String _text = "Catapora";
		}
		{
			String _name = "column1text16";
			String _text = "Cólera";
		}
		{
			String _name = "column1text17";
			String _text = "Diarreia";
		}
		{
			String _name = "column1text18";
			String _text = "Difteria";
		}
		{
			String _name = "column1text19";
			String _text = "Disenteria (o fluxo sanguinolento)";
		}
		{
			String _name = "column1text20";
			String _text = "Endocardite (doença do elfo da água)";
		}
		{
			String _name = "column1text21";
			String _text = "Ergotismo (fogo de santo antônio)";
		}
		{
			String _name = "column1text22";
			String _text = "Gonorreia";
		}
		{
			String _name = "column1text23";
			String _text = "Influenza (doença do suor)";
		}
		{
			String _name = "column1text24";
			String _text = "Lepra (lepra)";
		}
		{
			String _name = "column1text25";
			String _text = "Malária (a sezão)";
		}
		{
			String _name = "column1text26";
			String _text = "Sarampo";
		}
		{
			String _name = "column1text27";
			String _text = "Caxumba";
		}
		{
			String _name = "column1text28";
			String _text = "Peste (a morte negra)";
		}
		{
			String _name = "column1text29";
			String _text = "Pneumonia";
		}
		{
			String _name = "column1text30";
			String _text = "Escarlatina";
		}
		{
			String _name = "column1text31";
			String _text = "Escrófula (o mal do rei)";
		}
		{
			String _name = "column1text32";
			String _text = "Escorbuto";
		}
		{
			String _name = "column1text33";
			String _text = "Varíola (a peste vermelha)";
		}
		{
			String _name = "column1text34";
			String _text = "Tuberculose";
		}
		{
			String _name = "column1text35";
			String _text = "Febre Tifoide (tifo)";
		}
		{
			String _name = "column1text36";
			String _text = "Coqueluche";
		}
		{
			String _name = "column1text37";
			String _text = "Febre Amarela";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "probabilidade de morte: improvável";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "probabilidade de morte: possível";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "probabilidade de morte: comum";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "probabilidade de contrair: muito baixa";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "probabilidade de contrair: baixa";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "probabilidade de contrair: ocasional";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "probabilidade de contrair: comum";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "probabilidade de contrair: alta";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "probabilidade de contrair: muito alta";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "pode ser transmitida? não";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "pode ser transmitida? sim";
		}
		{
			String _name = "column2text01";
			String _text = "Ícones de saúde:";
		}
		{
			String _name = "column2text02";
			String _text = "A saúde de um cidadão é determinada por muitos fatores:";
		}
		{
			String _name = "column2text03";
			String _text = "Ter uma dieta completa composta de muitos alimentos de todas as categorias: Frutas, Grãos, Proteínas e Vegetais.";
		}
		{
			String _name = "column2text04";
			String _text = "Herbalistas com amplo suprimento de Ervas e medicamentos.";
		}
		{
			String _name = "column2text05";
			String _text = "Médicos e uma capacidade adequada de atendimento de pacientes para a rápida prevenção de doenças e enfermidades.";
		}
		{
			String _name = "column2text06";
			String _text = "Barcos comerciais e Nômades carregam um alto risco de trazer doenças e enfermidades às vilas. Isso pode reduzir drasticamente a saúde dos cidadãos se controles preventivos não estiverem em vigor.";
		}
		{
			String _name = "column2text07";
			String _text = "Da mesma forma, a falta de Herbalistas para administrar, ou um suprimento inadequado de Ervas e Medicamentos, significará que doenças comuns serão frequentes entre os aldeões. Isso se torna preocupante com cidadãos excessivamente doentes, que são propensos a hospedar e transmitir doenças mortais.";
		}
		{
			String _name = "column2text08";
			String _text = "É extremamente importante manter seus cidadãos aquecidos à medida que as temperaturas caem. Isso significa não apenas um suprimento pronto de combustíveis para uma residência, mas também caminhos e estradas adequados para que os cidadãos alcancem lugares aquecidos rapidamente.";
		}
		{
			String _name = "column2text09";
			String _text = "Edifícios que oferecem saúde aos cidadãos são distinguidos pelas cores de seu raio:";
		}
		{
			String _name = "column2text10";
			String _text = "Herbalistas são conhecidos por colher, preparar e administrar ervas medicinais para os diversos males menores que acometem os cidadãos ao longo de suas vidas.";
		}
		{
			String _name = "column2text11";
			String _text = "Hospitais e Médicos são necessários para o tratamento de doenças e enfermidades de natureza infecciosa e mortal, bem como males complicados como ossos quebrados (veja a lista à esquerda).";
		}
		{
			String _name = "column3text01";
			String _text = "Ícones de felicidade:";
		}
		{
			String _name = "column3text02";
			String _text = "A Felicidade de um cidadão é dividida nas seguintes categorias positivas concedidas por edifícios, sendo facilmente identificáveis pelas cores correspondentes de seu raio:";
		}
		{
			String _name = "column3text03";
			String _text = "Segurança";
		}
		{
			String _name = "column3text04";
			String _text = "Bens";
		}
		{
			String _name = "column3text05";
			String _text = "Espírito";
		}
		{
			String _name = "column3text06";
			String _text = "Entretenimento";
		}
		{
			String _name = "column3text07";
			String _text = "Álcool";
		}
		{
			String _name = "column3text08";
			String _text = "Outro";
		}
		{
			String _name = "column3text09";
			String _text = "Além disso, há também um aspecto negativo às vezes causado por edifícios barulhentos, malcheirosos ou perigosos:";
		}
		{
			String _name = "column3text10";
			String _text = "Detração";
		}
		{
			String _name = "column3text11";
			String _text = "A depressão se torna muito real para cidadãos infelizes, eles ficarão ociosos com mais frequência e se tornarão menos produtivos.";
		}
		{
			String _name = "column3text12";
			String _text = "E como em uma espiral descendente: quanto menos trabalho realizam, mais infelizes ficam.";
		}
		{
			String _name = "column3text13";
			String _text = "Mantendo seus cidadãos seguros por meio de poços de combate a incêndio, ou até mesmo torres de guarda e muralhas.";
		}
		{
			String _name = "column3text14";
			String _text = "Mercados, Mercadores e Entrepostos Comerciais, junto com alguns edifícios de produção, podem trazer felicidade de Bens aos cidadãos.";
		}
		{
			String _name = "column3text15";
			String _text = "Garantindo que suas necessidades Espirituais sejam atendidas por Capelas e locais de culto e oração, mas também por cemitérios e locais onde os cidadãos possam lamentar seus entes perdidos.";
		}
		{
			String _name = "column3text16";
			String _text = "A felicidade de Entretenimento é dividida em duas categorias, definidas pelas cores de seu raio:";
		}
		{
			String _name = "column3text17";
			String _text = "Álcool, Estalagens e Tavernas. Os cidadãos gostam de consumir álcool e da vida nas tavernas. Mantenha as adegas e cervejarias cheias.";
		}
		{
			String _name = "column3text18";
			String _text = "Outra felicidade de Entretenimento pode vir de teatros, monumentos ou outros edifícios não relacionados ao álcool.";
		}
		{
			String _name = "column3text19";
			String _text = "O raio de edifícios com Detração influenciará negativamente qualquer cidadão dentro dele. Através do planejamento urbano e da construção de influenciadores positivos ao redor desses edifícios de produção, você pode garantir que os trabalhadores não fiquem excessivamente infelizes.";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "Combustíveis Domésticos";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "Combustíveis Domésticos";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "- dos combustíveis que os cidadãos usarão para aquecer suas casas -";
		}
		{
			String _name = "column1text01a";
			String _text = "O aquecimento de uma casa é tão importante quanto o telhado e as paredes que contêm o calor. A lareira de uma casa é o que a torna um lar, é onde os cidadãos se manterão aquecidos e cozinharão suas refeições.";
		}
		{
			String _name = "column1text01b";
			String _text = "Dependendo da habitação, a necessidade de combustível só existe abaixo de uma certa temperatura. Por exemplo, as casas de madeira e pedra padrão exigirão combustível para manter os cidadãos aquecidos a 50 graus F e abaixo (isso representa a qualidade do isolamento das casas, sendo capaz de suportar temperaturas mais baixas).";
		}
		{
			String _name = "column1text01c";
			String _text = "A variação no aquecimento das habitações padrão vem da quantidade de calor e tempo disponíveis a partir de um combustível doméstico (o quão eficiente é a lareira/fogo). Uma casa de madeira terá uma classificação de aquecimento de 60, enquanto a casa de pedra terá uma classificação de aquecimento de 90, obtendo assim mais calor com menos combustível.";
		}
		{
			String _name = "valueTip";
			String _text = "Valor do produto";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valor do produto, este produto tem um valor flutuante; como tal, os mercadores podem oferecer ou comprar a um preço dentro desta faixa";
		}
		{
			String _name = "weightTip";
			String _text = "Peso do produto";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantidade de produto produzido por trabalhadores instruídos ou não instruídos";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "é feito de:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "ou:";
		}
		{
			String _name = "Firewood00";
			String _text = "Lenha";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "A Lenha é produzida e armazenada sob o limite de Combustível: Doméstico. 6 são feitas a partir de uma Tora, tanto por lenhadores instruídos quanto não instruídos.";
		}
		{
			String _name = "Firewood01";
			String _text = "1 Tora";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "Há um custo de insumo por ciclo de 5 para a tora única. Tanto trabalhadores Não Instruídos quanto Instruídos obterão um lucro total de 7 ou 1,17 por Lenha.";
		}
		{
			String _name = "Firewood02";
			String _text = "2 Madeira Serrada";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "Há um custo de insumo por ciclo de 8 para a madeira serrada. Tanto trabalhadores Não Instruídos quanto Instruídos obterão um lucro total de 4 ou 0,67 por Lenha.";
		}
		{
			String _name = "FirewoodQty";
			String _text = "Produção: 6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "Carvão";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "O Carvão, criado por uma reação térmica chamada pirólise, é produzido sob o limite de Combustíveis: Metalúrgico para controlar a produção. O Carvão também é um Combustível que será usado pelos cidadãos para aquecer suas casas, se disponível nas proximidades.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Toras";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 105. Trabalhadores Não Instruídos obterão um lucro de 133 ou 3,91 por unidade de Carvão, enquanto um trabalhador Instruído obterá um lucro total de 280 ou 5,09 por unidade de Carvão.";
		}
		{
			String _name = "CharcoalQty";
			String _text = "Produção: 34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

