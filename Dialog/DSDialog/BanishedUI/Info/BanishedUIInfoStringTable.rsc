StringTable InfoToolsCrafted
{
	Entry _strings
	[
		{
			String _name = "ToolsCrafted";
			String _text = "Ferramentas e Utensílios";
		}
		{
			String _name = "Title1";
			String _text = "Ferramentas, Bens Manufaturados e Utensílios";
		}
		{
			String _name = "Title2";
			String _text = "- das ferramentas e utensílios, sejam usados por todos os cidadãos ou pelos qualificados -";
		}
		{
			String _name = "column1text01";
			String _text = "As Ferramentas desempenham um papel muito importante para ajudar a criar uma cidade próspera. Ferramentas, isto é, do tipo usado por todos os cidadãos (Ferramentas de Bronze, Ferramentas de Ferro, Ferramentas de Aço etc.), são necessárias para necessidades econômicas e práticas. Usadas para realizar as tarefas mais essenciais: cortar madeira, limpar terrenos, semear e colher campos, mineração, forjaria, todas exigem o uso de ferramentas.";
		}
		{
			String _name = "column1text02";
			String _text = "Uma tarefa, ou edifício, recebe um número de tempo de trabalho; esta é a unidade de tempo gasta para realizar a tarefa e completar o ciclo/produção. Mas junto com isso há um número de trabalho necessário, este número representa a quantidade física real de trabalho necessária para cada ciclo. E é esse número que influencia diretamente, e é influenciado pelas Ferramentas.";
		}
		{
			String _name = "column1text03";
			String _text = "À direita você verá a lista de ferramentas disponíveis, abaixo do nome de cada ferramenta está o símbolo:";
		}
		{
			String _name = "column1text04";
			String _text = "Este símbolo, e o número ao lado dele, representam a qualidade da ferramenta e o número de unidades de trabalho que ela é capaz de realizar antes de 'quebrar'.";
		}
		{
			String _name = "column1text05";
			String _text = "Um cidadão sem uma ferramenta não só tende a ser muito lento na produção de bens, como também será prejudicado na coleta e colheita de alimentos, na derrubada de árvores e no corte de lenha. A construção de edifícios também é seriamente prejudicada se um construtor não tiver uma ferramenta.";
		}
		{
			String _name = "column1text06";
			String _text = "As mudanças no jogo com os mods DS ativos fizeram com que a produção de Ferro deixasse de ser tão simples quanto coletá-lo da superfície, ou ter uma mina produzindo-o facilmente com custo limitado envolvido.";
		}
		{
			String _name = "column1text07";
			String _text = "uma visão geral das mudanças:";
		}
		{
			String _name = "column1text08";
			String _text = "-O Ferro nativo não está mais disponível na superfície do mapa; em vez disso, há pequenas quantidades de Minério de Ferro, Minério de Cobre e Minério de Estanho encontradas pela paisagem.";
		}
		{
			String _name = "column1text08a";
			String _text = "-Os Minérios de Cobre e Estanho são os minérios mais predominantes encontrados na superfície. O Minério de Ferro é encontrado em quantidades menores.";
		}
		{
			String _name = "column1text09";
			String _text = "-As minas produzirão apenas minérios (assim como carvão) em vez dos metais nativos (ferro, cobre, etc.).";
		}
		{
			String _name = "column1text09a";
			String _text = "-A produção de mineração agora terá um custo de Toras ou Madeira Serrada e Óleo de Lamparina ou Velas.";
		}
		{
			String _name = "column1text10";
			String _text = "-O Minério de Ferro precisará ser fundido em um forno com um Combustível Metalúrgico (Coque ou Carvão) para produzir Ferro. O mesmo vale para o Cobre e outros metais e ligas.";
		}
		{
			String _name = "column1text10a";
			String _text = "-A produção de Coque vem da mineração e do 'cozimento' do Carvão. O Carvão vegetal vem da carbonização de Toras.";
		}
		{
			String _name = "column1text10b";
			String _text = "-A introdução do Minério de Cobre na superfície permite a produção de uma ferramenta simples no início do jogo; uma Ferramenta de Cobre pode ser fundida usando apenas lenha (veja a lista à direita).";
		}
		{
			String _name = "column1text10c";
			String _text = "-Produzir ferramentas de maior qualidade que precisam de forjamento adicional para maior resistência (ferramentas de aço e temperadas) exigirá o uso de um combustível metalúrgico.";
		}
		{
			String _name = "column1text11a";
			String _text = "As ferramentas podem ser processadas e afiadas ainda mais para se tornarem versões 'finas' de si mesmas em uma Pedra de Amolar. Essas ferramentas são identificadas por um asterisco (*) após o nome. Essas ferramentas terão uma durabilidade 25 unidades de trabalho maior em comparação com suas versões normais.";
		}
		{
			String _name = "column1text11b";
			String _text = "Se também forem processadas e 'untadas', com o uso de Óleo de Linhaça, essas ferramentas se beneficiarão de uma durabilidade aumentada de 50 unidades de trabalho. Essas ferramentas são identificadas por um asterisco e um circunflexo (*^) após o nome.";
		}
		{
			String _name = "column1text12";
			String _text = "Existem outros tipos de ferramentas, da variedade de bens manufaturados e utensílios; são usadas por várias profissões, seja na produção de bens, seja na construção de edifícios.";
		}
		{
			String _name = "column1text13a";
			String _text = "Ferramentas:Pedreiro";
		}
		{
			String _name = "column1text13b";
			String _text = "Exigidas como custo de produção para extrair pedra de pedreiras, a introdução das Ferramentas:Pedreiro também reduziu o alto risco e a probabilidade de morte ocupacional que os Cortadores de Pedra enfrentavam. Também usadas como custo de construção em alguns edifícios de pedra maiores.";
		}
		{
			String _name = "column1text14a";
			String _text = "Ferramentas:Pescador";
		}
		{
			String _name = "column1text14b";
			String _text = "Exigidas como custo de construção para construir locais de pesca, eram anteriormente chamadas de Equipamento de Pesca em versões anteriores dos mods DS.";
		}
		{
			String _name = "column1text15a";
			String _text = "Ferramentas:Caçador";
		}
		{
			String _name = "column1text15b";
			String _text = "Exigidas como custo de construção para construir locais de caça, eram anteriormente chamadas de Equipamento de Caça em versões anteriores dos mods DS.";
		}
		{
			String _name = "column1text16a";
			String _text = "Cesto de Coleta";
		}
		{
			String _name = "column1text16b";
			String _text = "Exigido como custo de construção para construir locais de coleta, bem como custo de produção para a coleta de Bolotas.";
		}
		{
			String _name = "column1text17";
