			String _text = "1 Coque ou Carvão";
		}
		{
			String _name = "Pottery01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 19-20 (Carvão-Coque). Trabalhadores Não Instruídos obterão um lucro total de 4-5 (Coque-Carvão), pois apenas 3 unidades de Cerâmica serão produzidas; enquanto um trabalhador Instruído produzirá 4 unidades de Cerâmica com um lucro total de 12-13 ou 3-3,25 por unidade de Cerâmica.";
		}
		{
