		}
		{
			String _name = "BronzeWeight";
			String _text = "25";
		}
		{
			String _name = "column2text16";
			String _text = "Prata";
		}
		{
			String _name = "Silver00Tip";
			String _text = "A maravilhosa Prata, comumente usada como moeda, sendo um item de alto valor e baixo peso, é produzida sob seu próprio limite para controlar a produção/acumulação.";
		}
		{
			String _name = "column2text17";
			String _text = "2 Minério de Prata + ";
		}
		{
			String _name = "column2text18";
			String _text = "1 Coque ou Carvão";
		}
		{
			String _name = "Silver01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 23-24 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 2-3, pois apenas 1 unidade de Prata será produzida; enquanto um trabalhador Instruído obterá um lucro total de 18-19 (Coque-Carvão) ou 9-9,5 por unidade de Prata.";
		}
		{
			String _name = "SilverQty";
			String _text = "Produção: 1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
			String _name = "SilverWeight";
			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "Lingote de Prata";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "Um artesão habilidoso é capaz de forjar com sucesso um Lingote de Prata, usando menos combustível para uma massa maior de prata, de maior valor e usado como moeda; é produzido sob o limite de Prata para controlar a produção/acumulação.";
		}
		{
			String _name = "column2text20";
			String _text = "6 Minério de Prata + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 Coque ou Carvão";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "Este método tem um custo de insumo por ciclo de 55-56 (Carvão-Coque). Trabalhadores Não Instruídos terão uma perda de 5-6, pois não conseguirão manter o calor do forno com uma quantidade tão pequena de combustível, produzindo apenas 1 Lingote de Prata; enquanto um trabalhador Instruído e habilidoso obterá um lucro total de 44-45 (Coque-Carvão) ou 22-22,5 por Lingote de Prata.";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "Produção: 1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
		{
			String _name = "SilverIngotWeight";
			String _text = "50";
		}
		{
			String _name = "GoldTitle";
			String _text = "Ouro";
		}
		{
			String _name = "Gold00Tip";
			String _text = "O Ouro, embora não seja minerado propositalmente, nem encontrado em quantidades suficientes para isso, é encontrado em sua forma nativa pura e às vezes extraído em minas de prata ou garimpado ao longo de rios e riachos. Usado como moeda, o Ouro também tem seu próprio limite para controlar a produção/acumulação.";
		}
		{
			String _name = "GoldQty";
			String _text = "Produção: 1";
		}
		{
			String _name = "Gold01Tip";
			String _text = "O Ouro é um metal raro e valioso, a probabilidade de encontrá-lo é baixa, uma chance de 1:21.";
