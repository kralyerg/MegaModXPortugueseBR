		{ String _name = "cc17WindmillTip";				String _text = "O Moinho de Vento da Cidade é um grande edifício capaz de produzir Farinha a partir de vários tipos de grãos. É o moinho mais rápido e eficiente disponível."; }

		{ String _name = "Watermill";					String _text = "Moinho de Água"; }
		{ String _name = "WatermillLwr";				String _text = "moinho de água"; }
		{ String _name = "WatermillTip";				String _text = "Um Moinho de Água produz farinha a partir de grãos e deve ser construído na margem de uma extensão de água. A farinha não é comestível e pode ser levada a uma padaria para ser preparada como alimento ou comercializada. Pressione F para alternar a aparência."; }

