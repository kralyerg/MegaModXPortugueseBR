		{ String _name = "DSSVHerbalist";			String _text = "Herborista da Aldeia"; }
		{ String _name = "DSSVHerbalistLwr";		String _text = "herborista da aldeia"; }
		{ String _name = "DSSVHerbalistTip";		String _text = "O Herborista da Aldeia desempenha um papel importante em manter seus cidadãos saudáveis. Ele coletará ervas e fornecerá saúde e cura simples aos cidadãos. Emprega 1-2 Herboristas. Requer 34 de trabalho para construir."; }	
		
		{ String _name = "DSSVHospital";			String _text = "Hospital da Aldeia"; }
		{ String _name = "DSSVHospitalLwr";			String _text = "hospital da aldeia"; }
		{ String _name = "DSSVHospitalTip";			String _text = "o Hospital da Aldeia fornecerá um local para seus cidadãos doentes visitarem e serem tratados por um médico. Construa isto para obter o hospital básico; após a construção, o hospital pode ser melhorado através de um botão no painel de informações do edifício. Requer 144 de trabalho."; }
		{ String _name = "HospitalUpgrade1Tip";			String _text = "Melhore o Hospital da Aldeia, com uma capacidade maior de 45 pacientes, empregando 1-2 médicos, com uma nova ala adicionada, uma muralha de pedra externa e uma pequena melhoria de jardim. Requer 55 de trabalho."; }
				
		
		{ String _name = "DSSVVillageHall";				String _text = "Salão da Aldeia"; }
		{ String _name = "DSSVVillageHallLwr";			String _text = "salão da aldeia"; }
		{ String _name = "DSSVVillageHallTip";			String _text = "o Salão da Aldeia trará felicidade aos cidadãos, além de registrar e mostrar os dados da aldeia para o jogador. Você pode ter no máximo 3 Salões da Aldeia em um mapa."; }
		
		{ String _name = "DSSVSchool";					String _text = "Escola Pequena da Aldeia"; }
		{ String _name = "DSSVSchoolLwr";				String _text = "escola pequena da aldeia"; }
		{ String _name = "DSSVSchoolTip";				String _text = "Escola Pequena da Aldeia. Fornece educação para 20 alunos, emprega 1 Professor. Requer 55 de trabalho para construir."; }
		
		{ String _name = "DSSVChapel";					String _text = "Capela da Aldeia"; }
		{ String _name = "DSSVChapelLwr";				String _text = "capela da aldeia"; }
		{ String _name = "DSSVChapelTip";				String _text = "Capela da Aldeia. capacidade para 50 cidadãos. Requer 89 de trabalho para construir."; }
		
		{ String _name = "DSSVChurch";					String _text = "Igreja da Aldeia"; }
		{ String _name = "DSSVChurchLwr";				String _text = "igreja da aldeia"; }
		{ String _name = "DSSVChurchTip";				String _text = "Igreja da Aldeia. capacidade para 120 cidadãos. Requer 144 de trabalho para construir."; }
		
