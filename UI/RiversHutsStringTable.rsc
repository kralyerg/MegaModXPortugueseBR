			String _text = "Ferramenta de Nivelamento";
		}
		{
			String _name = "NewMedievalFlatToolLwr";
			String _text = "ferramenta de nivelamento";
		}
		{
			String _name = "NewMedievalFlatToolTip";
			String _text = "A Ferramenta de Nivelamento serve para nivelar o solo de volta ao normal após excluir uma peça de Canal, uma Lagoa ou uma Mina a Céu Aberto... Também é muito útil para arrasar colinas. Ela colocará um X laranja no chão. Assim que a tarefa estiver concluída, você precisará usar a Ferramenta de Remover Edifício para se livrar do X laranja.";
		}
	]
}
