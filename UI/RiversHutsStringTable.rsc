			String _name = "ClearWildFood";
			String _text = "Coletar Alimento Selvagem";
		}
		{
			String _name = "ClearWildFoodLwr";
			String _text = "coletar alimento selvagem";
		}
		{
			String _name = "ClearWildFoodTip";
			String _text = "Colete e colha pontos de alimento selvagem na área selecionada. Dicas: Alimentos selvagens surgem de árvores e muitos alimentos novos surgem de flores.";
		}
		{
			String _name = "ClearFodder";
			String _text = "Coletar Forragem";
		}
		{
			String _name = "ClearFodderLwr";
			String _text = "coletar forragem";
		}
		{
			String _name = "ClearFodderTip";
			String _text = "Colete e colha canteiros de forragem-palha na área selecionada. Dicas: Forragem-palha é o material que você obtém ao colher canteiros de capim que você vê no chão. A forragem pode ser usada nos estábulos, pode ser transformada em feixes de lenha (lenha pelos lenhadores), pode ser usada como material de construção (apiário, pastagem sem cerca, celeiro de forragem...). Cada canteiro de capim cria 4-6 forragem-palha (valor 1). Estas são armazenadas em um estoque de construção.";
		}
		{
			String _name = "ClearFlower";
			String _text = "Coletar Flores";
		}
		{
			String _name = "ClearFlowerLwr";
			String _text = "coletar flores";
		}
		{
			String _name = "ClearFlowerTip";
			String _text = "Colete e colha pontos de flores na área selecionada. Dicas: Flores têm a marcação diversos. Cada canteiro de flores cria 3-5 flores (valor 1). Certifique-se de ter celeiros que aceitem itens diversos.";
		}
		{
			String _name = "ClearHerb";
			String _text = "Coletar Ervas";
		}
		{
			String _name = "ClearHerbLwr";
			String _text = "coletar ervas";
		}
		{
			String _name = "ClearHerbTip";
			String _text = "Colete e colha pontos de ervas na área selecionada. Dicas: Ervas são usadas em um herborista (ou casa de banhos) para recuperar 1/2 coração por uso. Cada canteiro de ervas cria 2-3 ervas (valor 4). Ervas exigem armazenamento do tipo celeiro.";
		}
		{
			String _name = "ClearCopper";
			String _text = "Coletar Cobre e Estanho";
		}
		{
			String _name = "ClearCopperLwr";
			String _text = "coletar cobre";
		}
		{
			String _name = "ClearCopperTip";
			String _text = "Colete todo o cobre, estanho e outros minerais raros (ouro e prata) na área selecionada. Dicas: O cobre é usado para fazer algumas ferramentas e também como material de construção. O cobre e os outros minérios raros são minerais. Certifique-se de ter estoque de materiais disponível. 2-3 minérios de cobre são extraídos (valor 4), 1-2 minérios de prata (valor 11) ou 1-2 minérios de ouro (valor 22). Certifique-se de ter estoque de minerais disponível para armazená-los. ";
		}
		{
			String _name = "ClearAlmostAll";
			String _text = "Coletar Quase Tudo";
		}
		{
			String _name = "ClearAlmostAllLwr";
			String _text = "coletar quase tudo";
		}
		{
			String _name = "ClearAlmostAllTip";
			String _text = "Colete todos os minérios e pedras na área selecionada. Dicas: Esta ferramenta especial irá reunir todos os minérios e todas as pedras. Não irá remover as árvores, o capim e outras coisas selvagens valiosas. Muito útil para limpar rapidamente todas as terras ao redor dos silvicultores.";
		}
		{
			String _name = "ClearFirewood";
			String _text = "Coletar Madeira Morta";
		}
		{
			String _name = "ClearFirewoodLwr";
			String _text = "coletar madeira morta";
		}
		{
			String _name = "ClearFirewoodTip";
			String _text = "Colete toda a madeira morta na área selecionada para lenha. Dicas: Madeira morta são árvores mortas caídas. Colher pontos de madeira morta criará 5-8 lenha por árvore morta.";
		}
		{
			String _name = "ClearIron";
			String _text = "Coletar Minério de Ferro";
		}
