		{ String _name = "NMTTailorDock";			String _text = "Alfaiate"; }
		{ String _name = "NMTTailorDockLwr";			String _text = "alfaiate"; }
		{ String _name = "NMTTailorDockTip";			String _text = "Alfaiate das Docas NMT: um local de trabalho onde vários tipos de roupas são feitos. Tamanho: 7x5. Custo: 54 toras, 2 ferro. Emprega 1 alfaiate. Dicas: recursos necessários: casaco de couro (2 couro ou 1 couro + 1 tecido/linho, ou 2 tecido, ou 2 linho), casaco de lã (2 lã, ou 1 lã + 1 tecido/linho) ou casaco quente (2 couro + 2 lã/tecido/linho, ou 2 lã + 2 tecido/linho, ou 2 pele). Trabalhadores educados produzem 2 roupas; não educados produzem apenas 1 roupa. 3-4 tecido ou linho serão criados a partir de 12 algodão ou 12 linhaça."; }

		{ String _name = "NMTTailorStoneDock";			String _text = "Alfaiate"; }
		{ String _name = "NMTTailorStoneDockLwr";		String _text = "alfaiate"; }
		{ String _name = "NMTTailorStoneDockTip";		String _text = "Alfaiate de Pedra das Docas NMT: um local de trabalho onde vários tipos de roupas são feitos. Tamanho: 7x5. Custo: 54 pedra, 2 ferro. Emprega 1 alfaiate. Dicas: recursos necessários: casaco de couro (2 couro ou 1 couro + 1 tecido/linho, ou 2 tecido, ou 2 linho), casaco de lã (2 lã, ou 1 lã + 1 tecido/linho) ou casaco quente (2 couro + 2 lã/tecido/linho, ou 2 lã + 2 tecido/linho, ou 2 pele). Trabalhadores educados produzem 2 roupas; não educados produzem apenas 1 roupa. 3-4 tecido ou linho serão criados a partir de 12 algodão ou 12 linhaça."; }

		{ String _name = "NMTTavernDock";			String _text = "Taverna"; }
		{ String _name = "NMTTavernDockLwr";			String _text = "taverna"; }
		{ String _name = "NMTTavernDockTip";			String _text = "Taverna das Docas NMT: um local de trabalho onde cerveja, ale ou vinho é feito, armazenado e consumido; aumenta a felicidade dos cidadãos que vivem por perto. Tamanho: 7x7. Custo: 72 toras, 8 ferro, 12 vidro. Raio de felicidade (entretenimento): 30. Emprega de 1 a 3 cervejeiros. Dicas: recursos necessários: cerveja (10 malte), cerveja forte (10 malte, 2 lúpulo), ale (60 mirtilo ou 30 maçã, damasco, cereja, pêssego, pera ou abóbora), vinho (30 amora-preta, uva, ameixa, framboesa, amora, morango, melancia ou manga) ou hidromel (45 mel). Produzirá de 6 a 10 ale/cervejas/vinho."; }

		{ String _name = "NMTTavernStoneDock";			String _text = "Taverna"; }
		{ String _name = "NMTTavernStoneDockLwr";		String _text = "taverna"; }
		{ String _name = "NMTTavernStoneDockTip";		String _text = "Taverna das Docas de Pedra NMT: um local de trabalho onde cerveja, ale ou vinho é feito, armazenado e consumido; aumenta a felicidade dos cidadãos que vivem por perto. Tamanho: 7x7. Custo: 72 pedra, 8 ferro, 12 vidro. Raio de felicidade (entretenimento): 36. Emprega de 1 a 3 cervejeiros. Dicas: recursos necessários: cerveja (10 malte), cerveja forte (10 malte, 2 lúpulo), ale (60 mirtilo ou 30 maçã, damasco, cereja, pêssego, pera ou abóbora), vinho (30 amora-preta, uva, ameixa, framboesa, amora, morango, melancia ou manga) ou hidromel (45 mel). Produzirá de 6 a 10 ale/cervejas/vinho."; }

		{ String _name = "NMTDriftersDock";			String _text = "Doca dos Andarilhos"; }
		{ String _name = "NMTDriftersDockLwr";			String _text = "doca dos andarilhos"; }
		{ String _name = "NMTDriftersDockTip";			String _text = "Doca dos Andarilhos NMT: um local de trabalho cujo trabalho é pegar um barco e procurar troncos de árvores flutuantes não utilizados. Tamanho: 7x7. Custo: 48 toras, 8 ferro. Pode produzir: de 2 a 3 toras por trabalho. Emprega de 1 a 3 silvicultores. Dicas: você não os verá navegando com seus barcos, mas esse é o trabalho de RPG deles: vagar por aí e pegar toras flutuantes. Os números de produção são baseados em uma casa de silvicultor real."; }

		{ String _name = "NMTDriftersStoneDock";			String _text = "Doca dos Andarilhos"; }
		{ String _name = "NMTDriftersStoneDockLwr";			String _text = "doca dos andarilhos"; }
		{ String _name = "NMTDriftersStoneDockTip";			String _text = "Doca de Pedra dos Andarilhos NMT: um local de trabalho cujo trabalho é pegar um barco e procurar troncos de árvores flutuantes não utilizados. Tamanho: 7x7. Custo: 48 toras, 8 ferro. Pode produzir: de 2 a 3 toras por trabalho concluído. Emprega de 1 a 3 silvicultores. Dicas: você não os verá navegando com seus barcos, mas esse é o trabalho de RPG deles: vagar por aí e pegar toras flutuantes. Os números de produção são baseados em uma casa de silvicultor real."; }

		{ String _name = "NMTWaterMineDock";			String _text = "Doca de Mina Aquática"; }
		{ String _name = "NMTWaterMineDockLwr";			String _text = "doca de mina aquática"; }
		{ String _name = "NMTWaterMineDockTip";			String _text = "Doca de Mina Aquática NMT: um local de trabalho cujo trabalho é prender a respiração, mergulhar e minerar no fundo do mar. Tamanho: 10x10. Custo: 92 toras, 12 ferro. Pode produzir aleatoriamente: de 2 a 3 minérios ou pedras por trabalho concluído. Emprega de 1 a 8 mineradores. Dicas: parte do trabalho de RPG deles é mergulhar até o fundo do mar e minerar. Obtenha precioso minério de ferro, minério de cobre, pedra, minérios de prata e ouro, e possibilidade de gemas aleatoriamente."; }

