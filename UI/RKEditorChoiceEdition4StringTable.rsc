		{ String _name = "NMTSawmillDock";			String _text = "Serraria"; }
		{ String _name = "NMTSawmillDockLwr";			String _text = "serraria"; }
		{ String _name = "NMTSawmillDockTip";			String _text = "Serraria das Docas NMT: um local de trabalho onde madeira serrada ou lenha é produzida a partir de toras. Tamanho: 7x5. Custo: 48 toras, 12 ferro. Emprega de 1 a 3 lenhadores. Dicas: requer 1 tora para madeira serrada e 2 para lenha. Produzirá de 3 a 4 madeira serrada ou de 5 a 8 lenha por trabalho concluído."; }

		{ String _name = "NMTSawmillStoneDock";			String _text = "Serraria"; }
