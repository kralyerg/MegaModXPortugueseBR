		{ String _name = "NMTWoodcutterDockTip";		String _text = "Lenhador das Docas NMT: um local de trabalho onde a lenha é produzida. Tamanho: 4x5. Custo: 32 toras. Emprega de 1 a 2 lenhadores. Dicas: requer 2 toras ou 5 madeira serrada ou 5 forragem-palha. Produzirá de 5 a 8 lenha por trabalho concluído."; }

