		{ String _name = "EgyptEasyName";		String _text = "Egito - Fácil"; }
		{ String _name = "EgyptEasyDesc";		String _text = "Um jogo Fácil padrão apenas com Palmeiras. Um jogo fácil começa com seis famílias. Uma grande quantidade de roupas, alimentos, lenha, materiais de construção e ferramentas é fornecida. Casas e áreas de armazenamento já foram construídas. Sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }

		{ String _name = "EgyptMediumName";		String _text = "Egito - Médio"; }
		{ String _name = "EgyptMediumDesc";		String _text = "Um jogo Médio padrão apenas com Palmeiras. Um jogo médio começa com cinco famílias. Roupas, alimentos, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído. Algumas sementes para campos e pomares estão disponíveis."; }

		{ String _name = "EgyptHardName";		String _text = "Egito - Difícil"; }
		{ String _name = "EgyptHardDesc";		String _text = "Um jogo Difícil padrão apenas com Palmeiras. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, alimentos, lenha e ferramentas é fornecida. Nenhuma semente para cultivo está disponível."; }

		{ String _name = "EgyptAEName";			String _text = "Egito - Adão & Eva"; }
		{ String _name = "EgyptAEDesc";			String _text = "Um jogo Adão & Eva padrão apenas com Palmeiras. Comece com apenas 2 pessoas. Uma pequena quantidade de alimentos, lenha e roupas é fornecida em um pequeno carrinho de armazenamento. Nenhuma estrutura foi construída, nenhuma semente ou gado está disponível inicialmente - você terá que sobreviver e adquirir tudo."; }

