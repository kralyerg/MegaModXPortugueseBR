StringTable resource
{
	Entry _strings
	[
		{
			String _name = "DSVillageSquareMeadBrewer";
			String _text = "Fabricante de Hidromel da Praça da Vila";
		}
		{
			String _name = "DSVillageSquareMeadBrewerLwr";
			String _text = "fabricante de hidromel da praça da vila";
		}
		{
			String _name = "DSVillageSquareMeadBrewerTip";
			String _text = "o Fabricante de Hidromel da Praça da Vila, um pequeno edifício para preparar e servir Hidromel e Hidromel Quente. O Hidromel é feito a partir de: Mel e Água ou Mel Silvestre e Água. O Hidromel Quente usa Hidromel e Ervas. Emprega 1 Cervejeiro. O Fabricante de Hidromel pode armazenar um total combinado de 250 de peso. A construção requer 55 de trabalho.";
		}
		{
			String _name = "DSVillageMeadery";
			String _text = "Hidromelaria da Vila";
		}
		{
			String _name = "DSVillageMeaderyLwr";
			String _text = "hidromelaria da vila";
		}
		{
			String _name = "DSVillageMeaderyTip";
			String _text = "a Hidromelaria da Vila, uma taverna que prepara e serve Hidromel e Hidromel Quente aos cidadãos. O Hidromel é feito a partir de: Mel e Água ou Mel Silvestre e Água. O Hidromel Quente usa Hidromel e Ervas. Emprega de 1 a 4 Cervejeiros. A hidromelaria pode armazenar um total combinado de 600 de peso. A construção requer 144 de trabalho.";
		}
		{
			String _name = "MeadWaterRequire";
			String _text = "Hidromel (40 Mel + 20 Água)";
		}
		{
			String _name = "MeadWildHoneyWaterRequire";
			String _text = "Hidromel (40 Mel Silvestre + 20 Água)";
		}
		{
			String _name = "MulledMeadRequire";
			String _text = "Hidromel Quente (1 Hidromel + 1 Erva)";
		}
		{
			String _name = "DSVillageStorageShed2x2";
			String _text = "Galpão de Armazenamento da Vila - 2x2";
		}
