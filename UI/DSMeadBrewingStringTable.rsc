		}
		{
			String _name = "DSVillageStorageShed2x3Tip";
			String _text = "O Galpão de Armazenamento da Vila 2x3 é um simples abrigo encostado para armazenar todos os Alimentos, Ervas e Remédios, Ferramentas, Roupas e Produtos Manufaturados e Utensílios. Capacidade total de armazenamento de 1250 de peso. A construção requer 29 de trabalho.";
		}
		{
			String _name = "DSVillageBeehiveTrunks";
			String _text = "Colmeias da Vila";
