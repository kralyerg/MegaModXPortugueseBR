		{
			String _name = "Huoshan";
			String _text = "[IC] Santo Vulcão - Astor Yao";
		}
		{
			String _name = "HuoshanLwr";
			String _text = "[IC] Santo Vulcão - Astor Yao";
		}
		{
			String _name = "HuoshanTip";
			String _text = "Um continente dos tempos antigos. Escolha o melhor terreno, com mais planícies. Como vivem perto do Santo Vulcão, as pessoas desta região vivem até os 60 anos e têm filhos entre os 10 e os 50 anos, mas essas pessoas têm velocidade e capacidade de manuseio mais rápidas; portanto, você não introduz refugiados. O jogo começa nas proximidades do Santo Vulcão, e o Santo Vulcão pode abençoar a ferramenta amaldiçoada, transformando-a em uma ferramenta sagrada (que pode ser usada para sempre por alguém).";
		}
		{
			String _name = "Dachengbao";
			String _text = "O castelo enorme";
		}
