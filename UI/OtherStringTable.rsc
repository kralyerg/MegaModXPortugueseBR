		{ String _name = "NoTreeAEDesc";		String _text = "Sem Árvores. Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em um pequeno carrinho de armazenamento."; }

		{ String _name = "NoTreeEasy";			String _text = "Sem Árvores - Fácil"; }
		{ String _name = "NoTreeEasyDesc";		String _text = "Sem Árvores. Um jogo fácil começa com seis famílias. Uma grande quantidade de roupas, 
