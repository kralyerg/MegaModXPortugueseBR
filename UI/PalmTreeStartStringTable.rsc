		{ String _name = "PalmsOnlyEasyName";		String _text = "Palmeiras - Fácil"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Um jogo Fácil padrão apenas com Palmeiras e árvores Tropicais. Um jogo fácil começa com seis famílias. Uma grande quantidade de roupas, comida, lenha, materiais de construção e ferramentas é fornecida. Casas e áreas de armazenamento já foram construídas. Sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palmeiras - Médio"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Um jogo Médio padrão apenas com Palmeiras e árvores Tropicais. Um jogo médio começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído. Algumas sementes para campos e pomares estão disponíveis."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palmeiras - Difícil"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Um jogo Difícil padrão apenas com Palmeiras e árvores Tropicais. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, comida, lenha e ferramentas é fornecida. Nenhuma semente para agricultura está disponível."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palmeiras - Adão & Eva"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Um jogo Adão & Eva padrão apenas com Palmeiras e árvores Tropicais. Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em uma pequena carroça de armazenamento. Nenhuma estrutura foi construída, nenhuma semente ou gado está disponível inicialmente - você terá que sobreviver e adquirir tudo."; }

