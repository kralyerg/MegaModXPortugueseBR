	{ String _name = "DSSVPlainsNoLakes";	String _text = "Planície sem Lago [DSSV]"; }
	{ String _name = "DSSVMountainLakes";	String _text = "Lagos nas Montanhas [DSSV]"; }
	{ String _name = "DSSVTerrainDesc";	String _text = "[DSSV] = DS Pequena Vila v2 - Novas Condições Iniciais e informações sobre novos tipos de Terreno:
																	Lago - Um grande lago central, com uma pequena quantidade de terra utilizável ao redor da borda.
																	Planície com Lago - Um mapa plano do tipo 'Planícies', com um rio, além de um lago de tamanho pequeno.
																	Planície sem lago -- como o anterior - um mapa de planícies plano, mas desta vez, sem lagos.
																	Lagos nas Montanhas - Um mapa difícil, quase inabitável, com grandes cadeias de montanhas
																	dominando a paisagem, e lagos profundos do tipo 'fiorde'."; }
	]
}

