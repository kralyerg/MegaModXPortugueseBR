	{ String _name = "DSSVJettyFishmongerTip";	String _text = "O Peixeiro do Cais vai selecionar e limpar os Peixes capturados no Cais, Pontes ou Docas de Pesca. Peixes selecionados podem ter um valor de comércio maior, e ocasionalmente um peixe extra é encontrado, aumentando a captura total. O recurso Peixe será transformado em uma seleção de Robalo, Brema, Carpa, Bacalhau, Enguia, Tainha, Perca, Lúcio, Salmão, Tenca, Truta."; }
	{ String _name = "DSSVJettyMolluscFarm";	String _text = "Fazenda de Moluscos do Cais"; }
	{ String _name = "DSSVJettyMolluscFarmLwr";	String _text = "fazenda de moluscos do cais"; }
	{ String _name = "DSSVJettyMolluscFarmTip";	String _text = "Uma Fazenda de Moluscos do Cais, emprega até 2 pescadores para criar e coletar Mexilhões, Amêijoas e Caracóis. 4x4."; }
	{ String _name = "DSSVJettyPoultryShelter";	String _text = "Abrigo de Aves do Cais"; }
