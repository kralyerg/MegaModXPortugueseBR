		{ String _name = "Forwardpost";				String _text = "Posto Avançado"; }
		{ String _name = "ForwardpostLwr";			String _text = "posto avançado"; }
		{ String _name = "ForwardpostTip";			String _text = "Este posto representa uma das incursões de suas forças militares em território inimigo. A guerra bem-sucedida nesta era exige armas e uniformes coloridos e orgulhosos, mas ao vencer seus inimigos o posto gerará muitos itens úteis para sua colônia - incluindo diversos suprimentos de construção lucrativos, artefatos valiosos ou bens comerciais raros capturados dos derrotados."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Requer: Suprimento Militar.  Produz: Sortimento aleatório de Vinho, Aguardente, Mosquete, Canhão, Cerâmica, Pedras Preciosas, Casaco de Couro, Artefato Nativo."; }

		{ String _name = "MusketRange";				String _text = "Estande de Tiro"; }
