	[ 


	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{ String _name = "CCAdamEve";			String _text = "[CC] Adão e Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em uma pequena carroça de armazenamento. Nenhuma estrutura foi construída, nenhuma semente ou gado está disponível inicialmente - você terá que sobreviver e conseguir tudo."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Missionario"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Uma partida Missionario começa com uma Casa Paroquial e três famílias, 2 delas não-educadas. 2 casas ja estão construídas e alguns suprimentos basicos são fornecidos. Uma carroça de armazenamento está disponível. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nova Fronteira"; }
		{ String _name = "CCFortDesc";			String _text = "A Nova Fronteira começa em um posto avançado de fronteira próximo a uma aldeia nativa americana amigavel. Defenda e cuide de seus cidadãos e sua lenda será contada no oeste para sempre. Esta partida começa com 3 famílias e um pequeno forte com alguns suprimentos ja construído. Inclui a opção de descobrir tesouros em um terreno cerimonial."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Aldeia Nativa - Difícil"; }
		{ String _name = "CCFortHardDesc";		String _text = "O início Aldeia Nativa exige que você tenha boas relações com a tribo nativa da região e é um começo bastante difícil. A aldeia exigirá recursos (melhorias) para sinalizar sua amizade e então você terá a escolha de como deseja interagir com os edifícios. Como estrangeiros nesta terra, vocês têm muito a aprender e a ganhar buscando aliados em vez de inimigos."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Aldeia Nativa - Adão e Eva"; }
		{ String _name = "CCFortAEDesc";		String _text = "Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em uma pequena carroça de armazenamento. O início Aldeia Nativa exige que você tenha boas relações com a tribo nativa da região e é um começo bastante difícil. A aldeia exigirá recursos (melhorias) para sinalizar sua amizade e então você terá a escolha de como deseja interagir com os edifícios. Como estrangeiros nesta terra, vocês têm muito a aprender e a ganhar buscando aliados em vez de inimigos."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] A Maldição da Lhama Dourada - Fácil"; }
		{ String _name = "LlamaEasyDesc";		String _text = "A Maldição da Lhama Dourada é a coisa mais próxima de um mistério no mundo de Banished. O que é a Lhama Dourada? Que mistérios ela guarda? Você ousa explorar seu interior sombrio? Esta é uma partida que começa de acordo com as configurações normais de Fácil, mas inclui a opção de se aventurar em busca de tesouros. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] A Maldição da Lhama Dourada - Médio"; }
		{ String _name = "LlamaMediumDesc";		String _text = "A Maldição da Lhama Dourada é a coisa mais próxima de um mistério no mundo de Banished. O que é a Lhama Dourada? Que mistérios ela guarda? Você ousa explorar seu interior sombrio? Esta é uma partida que começa de acordo com as configurações normais de Médio, mas inclui a opção de se aventurar em busca de tesouros."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] A Maldição da Lhama Dourada - Difícil"; }
		{ String _name = "LlamaHardDesc";		String _text = "A Maldição da Lhama Dourada é a coisa mais próxima de um mistério no mundo de Banished. O que é a Lhama Dourada? Que mistérios ela guarda? Você ousa explorar seu interior sombrio? Esta é uma partida que começa de acordo com as configurações normais de Difícil, mas inclui a opção de se aventurar em busca de tesouros. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] A Maldição da Lhama Dourada - Adão e Eva"; }
		{ String _name = "LlamaAEDesc";			String _text = "A Maldição da Lhama Dourada é a coisa mais próxima de um mistério no mundo de Banished. O que é a Lhama Dourada? Que mistérios ela guarda? Você ousa explorar seu interior sombrio? Esta é uma partida que começa de acordo com as configurações de Adão e Eva, mas inclui a opção de se aventurar em busca de tesouros. "; }


