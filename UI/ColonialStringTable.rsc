		{ String _name = "Stitcher";					String _text = "Fabricante de Uniformes"; }
		{ String _name = "StitcherLwr";					String _text = "fabricante de uniformes"; }
		{ String _name = "StitcherTip";					String _text = "O Fabricante de Uniformes é um especialista militar concentrado na produção de orgulhosos uniformes militares. Esses uniformes são essenciais para o moral dos soldados em batalha e são um componente importante da sua força militar. Faz apenas Libré Completa."; }
		
		{ String _name = "Quartermaster";				String _text = "Intendente"; }
		{ String _name = "QuartermasterLwr";			String _text = "intendente"; }
		{ String _name = "QuartermasterTip";			String _text = "O Intendente é a primeira e mais importante peça que você deve construir ao estabelecer uma presença militar em uma nova área. Quando ocupado, Suprimentos Militares serão trazidos em um fluxo constante por agentes da sua Marinha."; }

		{ String _name = "Firebundler";					String _text = "Galpão de Enfardamento"; }
