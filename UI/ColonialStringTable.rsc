		{ String _name = "RoperyTip";					String _text = "Uma Cordoaria é onde cânhamo, linho ou juncos são trançados em cordas. Fazer corda de cânhamo requer um pouco menos de matérias-primas do que linho, e juncos são necessários em grande quantidade."; }

		{ String _name = "Silkwormhut";					String _text = "Cabana de Bicho-da-Seda"; }
		{ String _name = "SilkwormhutLwr";				String _text = "cabana de bicho-da-seda"; }
		{ String _name = "SilkwormhutTip";				String _text = "Uma Cabana de Bicho-da-Seda cria bichos-da-seda para fazer seda e, em último caso, para alimentação. Requer Ovos de Bicho-da-Seda de um comerciante para construir. Quando construída, os Bichos-da-Seda precisam de folhas de amoreira branca como alimento. Isso pode ser negociado ou vir de um pomar."; }

