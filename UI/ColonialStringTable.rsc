		{ String _name = "ToolMakerUpgradeTip";			String _text = "Melhore para uma Ferraria Grande para desbloquear opções avançadas de construção. Alguns recursos do edifício existente serão recuperados. A Ferraria Grande e a Ferraria Rural oferecem as mesmas opções."; }
		{ String _name = "ToolMakerUpgradeTip2";		String _text = "Melhore para uma Ferraria Rural para desbloquear opções avançadas de construção. Alguns recursos do edifício existente serão recuperados. A Ferraria Grande e a Ferraria Rural oferecem as mesmas opções."; }
		{ String _name = "TailorUpgradeTip";			String _text = "Melhore para um Costureiro para melhores opções de roupas. Alguns recursos do edifício existente serão mantidos."; }
		{ String _name = "MineUpgradeTip";				String _text = "Melhore a Mina para mais produção de recursos."; }
		{ String _name = "QuarryUpgradeTip";			String _text = "Melhore a Pedreira para mais produção de recursos. Permite que o Terreno seja recuperado."; }
		{ String _name = "QuarryUpgradeTipSalt";		String _text = "Pedreira de Pedra e Sal. Melhore a Pedreira para mais produção de recursos."; }
		{ String _name = "BLMQuarryUpgradeTip";			String _text = "Melhore a Mina de Superfície para uma produção de recursos significativamente maior. Permite que o Terreno seja recuperado."; }
		{ String _name = "BLMQuarry2UpgradeTip";		String _text = "Melhore a Mina de Superfície para uma produção de recursos significativamente maior. Permite que o Terreno seja recuperado."; }
		{ String _name = "TinmineUpgradeTip";			String _text = "Melhore a Mina de Estanho para uma produção de recursos significativamente maior. Permite que o Terreno seja recuperado."; }
