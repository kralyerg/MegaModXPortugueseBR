		{ String _name = "CCcustom1Name";		String _text = "Colonial Charter"; }
		{ String _name = "CCcustom1Desc";		String _text = "Descrição do Colonial Charter Vai Aqui"; }

		{ String _name = "CCAdamEve";			String _text = "[CC] Adão e Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em um pequeno carrinho de armazenamento. Nenhuma estrutura foi construída, nenhuma semente ou gado está disponível inicialmente - você terá que sobreviver e conseguir tudo."; }

		{ String _name = "CCSilkRoad";			String _text = "[CC] Rota da Seda - Fácil"; }
		{ String _name = "CCSilkRoadDesc";		String _text = "Comece com a capacidade de alimentar e colher bichos-da-seda por sua preciosa seda. Começa com seis famílias. Uma grande quantidade de roupas, comida, lenha, materiais de construção e ferramentas é fornecida. Casas e áreas de armazenamento já foram construídas."; }
		
		{ String _name = "CCSilkRoadMed";		String _text = "[CC] Rota da Seda - Médio"; }
		{ String _name = "CCSilkRoadMedDesc";		String _text = "Comece com a capacidade de alimentar e colher bichos-da-seda por sua preciosa seda. Começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído."; }

		{ String _name = "CCSilkRoadHard";		String _text = "[CC] Rota da Seda - Difícil"; }
		{ String _name = "CCSilkRoadHardDesc";		String _text = "Comece com a capacidade de alimentar e colher bichos-da-seda por sua preciosa seda. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, comida, lenha e ferramentas é fornecida. Sementes de Amoreira-Branca são as únicas sementes disponíveis."; }
		
		{ String _name = "CCMine";			String _text = "[CC] Mina"; }

		{ String _name = "CCMineDesc";			String _text = "Mineração única para itens valiosos."; }

		{ String _name = "CCMediumPlus";		String _text = "[CC] Médio+"; }
		{ String _name = "CCMediumPlusDesc";		String _text = "Adiciona Gado. Um jogo médio+ começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Missionário"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Um jogo Missionário começa com uma Casa Paroquial e três famílias, 2 delas não educadas. 2 casas já estão construídas e alguns suprimentos básicos são fornecidos. Um carrinho de armazenamento está disponível. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nova Fronteira"; }
		{ String _name = "CCFortDesc";		String _text = "A Nova Fronteira o inicia em um posto avançado de fronteira ao lado de uma vila nativa americana amigável. Defenda e cuide de seus cidadãos e sua lenda será contada no oeste por todos os tempos. Este jogo começa com 3 famílias e um pequeno forte com alguns suprimentos já foi construído. Inclui a opção de descobrir tesouros em um local cerimonial."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Vila Nativa - Difícil"; }
		{ String _name = "CCFortHardDesc";		String _text = "O início na Vila Nativa exige que você tenha boas relações com a tribo nativa da área e é um começo bastante difícil. A vila exigirá recursos (melhorias) para sinalizar sua amizade e então você terá a escolha de como deseja interagir com os edifícios. Como estrangeiros nesta terra, vocês têm muito a aprender e a ganhar ao buscar aliados em vez de inimigos."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Vila Nativa - Adão e Eva"; }
		{ String _name = "CCFortAEDesc";		String _text = "Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em um pequeno carrinho de armazenamento. O início na Vila Nativa exige que você tenha boas relações com a tribo nativa da área e é um começo bastante difícil. A vila exigirá recursos (melhorias) para sinalizar sua amizade e então você terá a escolha de como deseja interagir com os edifícios. Como estrangeiros nesta terra, vocês têm muito a aprender e a ganhar ao buscar aliados em vez de inimigos."; }

		{ String _name = "PalmsOnlyEasyName";		String _text = "[CC] Antilhas - Fácil"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Um jogo Fácil padrão apenas com árvores de Palmeira e Tropicais. Um jogo fácil começa com seis famílias. Uma grande quantidade de roupas, comida, lenha, materiais de construção e ferramentas é fornecida. Casas e áreas de armazenamento já foram construídas. Sementes para campos e pomares estão disponíveis, assim como um rebanho de gado."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "[CC] Antilhas - Médio"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Um jogo Médio padrão apenas com árvores de Palmeira e Tropicais. Um jogo médio começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído. Algumas sementes para campos e pomares estão disponíveis."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "[CC] Antilhas - Difícil"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Um jogo Difícil padrão apenas com árvores de Palmeira e Tropicais. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, comida, lenha e ferramentas é fornecida. Nenhuma semente para agricultura está disponível."; }
		
		{ String _name = "PalmsOnlyHardFewName";		String _text = "[CC] Antilhas Esparsas - Difícil"; }
		{ String _name = "PalmsOnlyHardFewDesc";		String _text = "Um jogo Difícil padrão com quantidades esparsas de árvores de Palmeira e Tropicais apenas, e poucas pedras de superfície e minérios. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, comida, lenha e ferramentas é fornecida. Nenhuma semente para agricultura está disponível."; }

