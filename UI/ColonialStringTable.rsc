		{ String _name = "NewTrees2LiteHardDesc";	String _text = "Versão Lite para desempenho. Um jogo Difícil padrão apenas com árvores novas do mod - excluindo palmeiras. Um jogo difícil começa com quatro famílias. Uma pequena quantidade de roupas, comida, lenha e ferramentas é fornecida. Nenhuma semente para agricultura está disponível."; }

		{ String _name = "NewTrees2LiteAEName";		String _text = "[CC] Nuevo Arbol Lite - Adão e Eva"; }
		{ String _name = "NewTrees2LiteAEDesc";		String _text = "Versão Lite para desempenho. Um jogo Adão e Eva padrão apenas com árvores novas do mod - excluindo palmeiras. Uma pequena quantidade de comida, lenha e roupas é fornecida em um pequeno carrinho de armazenamento. Nenhuma estrutura foi construída, nenhuma semente ou gado está disponível inicialmente - você terá que sobreviver e conseguir tudo."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] A Maldição do Lhama Dourado - Fácil"; }
		{ String _name = "LlamaEasyDesc";		String _text = "A Maldição do Lhama Dourado é a coisa mais próxima de um mistério no mundo de Banished. O que é o Lhama Dourado? Que mistérios ele guarda? Você ousa explorar seu interior sombrio? Este é um jogo que começa de acordo com as configurações Fácil normais, mas inclui a opção de aventurar-se pela chance de um tesouro. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] A Maldição do Lhama Dourado - Médio"; }
		{ String _name = "LlamaMediumDesc";		String _text = "A Maldição do Lhama Dourado é a coisa mais próxima de um mistério no mundo de Banished. O que é o Lhama Dourado? Que mistérios ele guarda? Você ousa explorar seu interior sombrio? Este é um jogo que começa de acordo com as configurações Médio normais, mas inclui a opção de aventurar-se pela chance de um tesouro."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] A Maldição do Lhama Dourado - Difícil"; }
		{ String _name = "LlamaHardDesc";		String _text = "A Maldição do Lhama Dourado é a coisa mais próxima de um mistério no mundo de Banished. O que é o Lhama Dourado? Que mistérios ele guarda? Você ousa explorar seu interior sombrio? Este é um jogo que começa de acordo com as configurações Difícil normais, mas inclui a opção de aventurar-se pela chance de um tesouro. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] A Maldição do Lhama Dourado - Adão e Eva"; }
		{ String _name = "LlamaAEDesc";			String _text = "A Maldição do Lhama Dourado é a coisa mais próxima de um mistério no mundo de Banished. O que é o Lhama Dourado? Que mistérios ele guarda? Você ousa explorar seu interior sombrio? Este é um jogo que começa de acordo com as configurações Adão e Eva, mas inclui a opção de aventurar-se pela chance de um tesouro. "; }

		{ String _name = "OldCastleHardName";		String _text = "[CC] Castelo Antigo - Difícil"; }
		{ String _name = "OldCastleHardDesc";		String _text = "Comece no local de um Castelo Antigo que oferece um grande potencial de armazenamento. Alguns alimentos preservados e uma pequena quantidade de roupas, ferramentas e lenha foram descobertos. Não há Sementes ou Gado presentes."; }

		{ String _name = "BayouEasyName";		String _text = "[CC] Bayou - Fácil"; }
		{ String _name = "BayouEasyDesc";		String _text = "Bayou vem com tudo o que você precisa para colocar uma Cidade Portuária em funcionamento. Um pouco de Arroz, ferramentas, roupas e lenha são fornecidos. Galinhas também estão por perto."; }

		{ String _name = "PlainsEasyName";		String _text = "Planícies - Fácil"; }
		{ String _name = "PlainsEasyDesc";		String _text = "Teste"; }

		{ String _name = "FantasyEasyName";		String _text = "[CC] Todas as Coisas Selvagens - Fácil"; }
		{ String _name = "FantasyEasyDesc";		String _text = "A terra está coberta de todo tipo de recursos naturais de comida, prontos para serem colhidos na natureza. Pedras e Ferro também reaparecem. Este mapa é extremamente fácil e irrealista devido à abundância de recursos não naturais crescendo constantemente pela natureza. Fora isso, é um início fácil típico."; }

		{ String _name = "FantasyAEName";		String _text = "[CC] Todas as Coisas Selvagens - Adão e Eva"; }
		{ String _name = "FantasyAEDesc";		String _text = "A terra está coberta de todo tipo de recursos naturais de comida, prontos para serem colhidos na natureza. Pedras e Ferro também reaparecem. Este mapa é extremamente fácil e irrealista devido à abundância de recursos não naturais crescendo constantemente pela natureza. Fora isso, é um início Adão e Eva típico."; }

		{ String _name = "ShipwreckHardName";		String _text = "[CC] Naufrágio - Difícil"; }
		{ String _name = "ShipwreckHardDesc";		String _text = "Naufragados em uma terra desconhecida, seu povo tem apenas sua astúcia e o que pode resgatar dos destroços."; }

		{ String _name = "ShipwreckElDoradoHardName";	String _text = "[CC] Naufrágio - El Dorado - Difícil"; }
		{ String _name = "ShipwreckElDoradoHardDesc";	String _text = "Naufragados em uma terra desconhecida, seu povo tem apenas sua astúcia e o que pode resgatar dos destroços. Um jogo apenas com árvores novas do mod."; }

		{ String _name = "ShipwreckJungleHardName";	String _text = "[CC] Naufrágio - Selva - Difícil"; }
		{ String _name = "ShipwreckJungleHardDesc";	String _text = "Naufragados em uma terra desconhecida, seu povo tem apenas sua astúcia e o que pode resgatar dos destroços. Um jogo apenas com árvores de selva do mod."; }

		{ String _name = "ShipwreckPinesHardName";	String _text = "[CC] Naufrágio - Pinheiros do Norte - Difícil"; }
		{ String _name = "ShipwreckPinesHardDesc";	String _text = "Naufragados em uma terra desconhecida, seu povo tem apenas sua astúcia e o que pode resgatar dos destroços. Um jogo apenas com árvores de pinheiro do mod."; }

		{ String _name = "ShipwreckMediumName";		String _text = "[CC] Naufrágio - Médio+"; }
		{ String _name = "ShipwreckMediumDesc";		String _text = "Naufragados em uma terra desconhecida, uma pequena quantidade de madeira e pedra, junto com uma semente e gado, foram resgatados dos destroços."; }

		{ String _name = "ShipwreckElDoradoMediumName";	String _text = "[CC] Naufrágio - El Dorado - Médio+"; }
		{ String _name = "ShipwreckElDoradoMediumDesc";	String _text = "Naufragados em uma terra desconhecida, uma pequena quantidade de madeira e pedra, junto com uma semente e gado, foram resgatados dos destroços."; }

		{ String _name = "ShipwreckJungleMediumName";	String _text = "[CC] Naufrágio - Selva - Médio+"; }
		{ String _name = "ShipwreckJungleMediumDesc";	String _text = "Naufragados em uma terra desconhecida, uma pequena quantidade de madeira e pedra, junto com uma semente e gado, foram resgatados dos destroços."; }

		{ String _name = "ShipwreckPinesMediumName";	String _text = "[CC] Naufrágio - Pinheiros do Norte - Médio+"; }
		{ String _name = "ShipwreckPinesMediumDesc";	String _text = "Naufragados em uma terra desconhecida, uma pequena quantidade de madeira e pedra, junto com uma semente e gado, foram resgatados dos destroços."; }

		{ String _name = "AbandonedJungleHardName";	String _text = "[CC] Vila Abandonada - Selva"; }
		{ String _name = "AbandonedJungleHardDesc";	String _text = "No fundo da selva, seu povo encontra os restos de um assentamento independente anterior. Você tem a mesma quantidade de recursos disponíveis em um início Difícil padrão, porém algumas casas já estão construídas ou parcialmente construídas."; }

		{ String _name = "AbandonedPinesHardName";	String _text = "[CC] Vila Abandonada - Pinheiros do Norte"; }
