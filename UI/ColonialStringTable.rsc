		{ String _name = "ShorepitTip";					String _text = "Uma Casa da Costa é onde areia e argila podem ser escavadas para processamento posterior em uma Vidraçaria ou Olaria, e também onde sapos e tartarugas podem ser encontrados."; }
		
		{ String _name = "Chandlery";					String _text = "Casa de Velas"; }
