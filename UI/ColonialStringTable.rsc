		{ String _name = "WorkcampTip";					String _text = "O exército não é só sobre guerra - a construção e o desenvolvimento da paisagem sempre foram uma responsabilidade das forças militares em tempos de paz. Este acampamento de trabalho converte pagamento básico, ferramentas e a energia da guarnição inquieta em recursos básicos."; }
		{ String _name = "WorkcampBoxTip";				String _text = "Requer: Pfennig e Ferramentas de Ferro. Produz: Sortimento aleatório de Ferro, Vidro, Carvão, Tijolo, Cerâmica, Toras de Madeira."; }

		{ String _name = "LargeSmithy";					String _text = "Ferraria Grande"; }
		{ String _name = "LargeSmithyLwr";				String _text = "ferraria grande"; }
		{ String _name = "LargeSmithyTip";				String _text = "A Ferraria Grande é uma oficina enorme com até dois ferreiros, construída com o tamanho e equipada com o necessário para fazer muitos tipos de ferramentas e adicionalmente produzir mosquetes para a defesa da colônia."; }
		
		{ String _name = "RuralSmith";					String _text = "Ferraria Rural"; }
		{ String _name = "RuralSmithLwr";				String _text = "ferraria rural"; }
		{ String _name = "RuralSmithTip";				String _text = "A Ferraria Rural é uma oficina enorme com até dois ferreiros, construída com o tamanho e equipada com o necessário para fazer muitos tipos de ferramentas e adicionalmente produzir mosquetes para a defesa da colônia."; }

		{ String _name = "Clothier";					String _text = "Fabricante de Roupas"; }
