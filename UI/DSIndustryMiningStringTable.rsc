		}
		{
			String _name = "DSThaddSurrelLumbermillTip";
			String _text = "A Serraria de Thadd Surrel & família, 1-5 lenhadores operarão a serraria, processando Toras em Madeira Serrada ou Lenha. Requer 144 de trabalho para construir.";
		}
		{
			String _name = "DSWaterPowerFurnace";
			String _text = "Alto-forno Movido a Água";
		}
		{
			String _name = "DSWaterPowerFurnaceLwr";
			String _text = "alto-forno";
		}
		{
			String _name = "DSWaterPowerFurnaceTip";
			String _text = "Exigindo construção ao lado de um riacho ou rio, usando altas temperaturas e um grande fluxo de ar, este alto-forno é a adição perfeita a um assentamento industrial. A energia hidráulica é usada para operar grandes foles, forçando ar para dentro do forno. É capaz de processar grandes quantidades de Minério de Ferro em Ferro, Minério de Cobre em Cobre, Minério de Estanho em Estanho, ou Minérios de Cobre e Estanho em Bronze, com o auxílio de um combustível metalúrgico (coque ou carvão). Emprega 1-8 ferreiros. A construção do edifício requer 233 de trabalho.";
		}
		{
			String _name = "DSBlastFurnace";
			String _text = "Thadd Surrel & família: Alto-forno";
		}
		{
			String _name = "DSBlastFurnaceLwr";
			String _text = "alto-forno";
		}
		{
			String _name = "DSBlastFurnaceTip";
			String _text = "Podendo ser construído em terreno plano, este alto-forno consegue atingir altas temperaturas com a inclusão de uma máquina a vapor de caldeira de cobre para operar os foles. Este forno é a adição perfeita a um assentamento industrial. É capaz de processar grandes quantidades de Minério de Ferro em Ferro, Minério de Cobre em Cobre, Minério de Estanho em Estanho, ou Minérios de Cobre e Estanho em Bronze, com o auxílio de um combustível metalúrgico (coque ou carvão). Emprega 1-6 ferreiros. A construção do edifício requer 233 de trabalho. Variantes através da tecla F.";
		}
		{
			String _name = "DSHillLimeKiln";
			String _text = "Forno de Cal de Encosta";
		}
