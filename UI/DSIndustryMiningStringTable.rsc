StringTable startConditions
{
	Entry _strings
	[
		{
			String _name = "Easy0Name";
			String _text = "Indústria: Ferramentas";
		}
		{
			String _name = "Easy0Desc";
			String _text = "Um jogo fácil, começa com cinco famílias e casas. Uma grande quantidade de roupas, comida, lenha, carvão vegetal, ferramentas, toras, ferro e pedra é fornecida. Os celeiros de armazenamento de Thadd Surrel já foram construídos, assim como o Ferreiro de Thadd Surrel, e a Fornalha do Ferreiro e o Rebolo. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de gado.";
		}
		{
			String _name = "Easy2Name";
			String _text = "Indústria: Linho, Tecido de Linho e Óleo de Lamparina";
		}
		{
			String _name = "Easy2Desc";
			String _text = "Um jogo fácil, começa com cinco famílias e casas. Uma grande quantidade de roupas, comida, lenha, carvão vegetal, ferramentas, toras, ferro e pedra é fornecida. Os celeiros de armazenamento de Thadd Surrel já foram construídos, assim como o Tecelão de Linho, o Forno de Óleo e o Galpão de Prensagem de Thadd Surrel. Sementes de linho para o campo e uma semente de pomar estão disponíveis, assim como um rebanho de gado.";
		}
		{
			String _name = "Medium0Name";
			String _text = "Indústria: Armazenamento de Thadd Surrel";
		}
		{
			String _name = "Medium0Desc";
			String _text = "Um jogo médio, começa com cinco famílias. Roupas, comida, lenha, ferramentas e algumas toras, ferro e pedra são fornecidos. Os celeiros de armazenamento de Thadd Surrel já foram construídos. Algumas sementes para campos e pomares estão disponíveis.";
		}
		{
			String _name = "Hard0Name";
			String _text = "Indústria: Carvoeiros";
		}
		{
			String _name = "Hard0Desc";
			String _text = "Um jogo difícil, começa com quatro famílias. Alguma roupa, comida, ferramentas, pedra e uma grande quantidade de toras são fornecidas. Você tem alguns barris e caixas de armazenamento que guardam seus bens, além de duas Pilhas de Carvão Vegetal já construídas.";
		}
		{
			String _name = "Hard1Name";
			String _text = "Indústria: Fundidores de Minério";
		}
		{
			String _name = "Hard1Desc";
			String _text = "Um jogo difícil, começa com quatro famílias. Alguma roupa, comida, ferramentas, pedra, carvão vegetal e toras são fornecidos. Você tem alguns barris e caixas de armazenamento que guardam seus bens, além de dois Fornos de Fundição (cobre e ferro) e uma pequena Pilha de Carvão Vegetal já construídos.";
		}
	]

}
