		}
		{
			String _name = "DSClarenceSilverMine01Tip";
			String _text = "A Mina de Prata Clarence, uma grande mina de Minério de Prata, construída inicialmente no nível de 1ª estrela; a mina emprega 1-8 mineiros e requer Madeira Serrada e 2 Óleo de Lamparina para operar. A mina tem uma produção limitada antes de precisar ser aprimorada para continuar minerando minério de prata. Requer 89 de trabalho para construir.";
		}
		{
			String _name = "DSClarenceSilverMine02";
			String _text = "Mina de Prata Clarence, 2ª estrela";
		}
		{
			String _name = "DSClarenceSilverMine02Lwr";
			String _text = "mina de prata clarence";
		}
		{
			String _name = "DSClarenceSilverMine02Tip";
			String _text = "Aprimore a mina, estendendo a sala de triagem traseira para abrir espaço para uma abertura de mina maior. Os túneis existentes serão reforçados para suportar uma força de trabalho um pouco maior de 13 mineiros. A mina aprimorada terá uma produção total de 610 antes que um novo aprimoramento seja necessário. Requer 144 de trabalho para construir.";
		}
		{
			String _name = "DSClarenceSilverMine03";
			String _text = "Mina de Prata Clarence, 3ª estrela";
		}
		{
			String _name = "DSClarenceSilverMine03Lwr";
			String _text = "mina de prata clarence";
		}
		{
			String _name = "DSClarenceSilverMine03Tip";
			String _text = "Ao aprimorar a mina, você adicionará um grande sistema de polias suspenso, que permitirá uma mina mais profunda e uma extração mais rápida, com as polias facilitando o transporte dos minérios pesados até a superfície. A mina pode contratar até 21 mineiros. A mina aprimorada terá uma produção total de 1.597 antes que um novo aprimoramento seja necessário. Requer 233 de trabalho para construir.";
		}
		{
			String _name = "DSClarenceSilverMine04";
			String _text = "Mina de Prata Clarence, 4ª estrela";
		}
		{
			String _name = "DSClarenceSilverMine04Lwr";
			String _text = "mina de prata clarence";
		}
		{
			String _name = "DSClarenceSilverMine04Tip";
			String _text = "Aprimore e melhore ainda mais o sistema de polias adicionando mais uma polia! Extração ainda mais rápida, e agora a mina pode empregar até 34 mineiros. Mas isso não é tudo, a iluminação da mina também está sendo aprimorada, o retorno de produção é aumentado, com os mineiros agora precisando de apenas 1 Óleo de Lamparina. A mina aprimorada terá uma produção total de 4.181 antes que um novo aprimoramento seja necessário. Requer 377 de trabalho para construir.";
		}
		{
			String _name = "DSClarenceSilverMine05";
			String _text = "Mina de Prata Clarence, 5ª estrela";
		}
		{
			String _name = "DSClarenceSilverMine05Lwr";
			String _text = "mina de prata clarence";
		}
		{
			String _name = "DSClarenceSilverMine05Tip";
			String _text = "Ao aprimorar a mina, a instalação de trilhos ferroviários permitirá o uso de carrinhos mais rápidos, aumentando a taxa de produção. Esta é a profundidade final da mina, após a qual ela ficará esgotada de todo o Minério de Prata. Tem uma capacidade total de 10.946. Requer 610 de trabalho para construir.";
		}
