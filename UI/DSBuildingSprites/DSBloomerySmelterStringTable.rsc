StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "A fundição no forno é iniciada pelos Trabalhadores da vila, que limparão tudo da área e, em seguida, entregarão os minérios, o carvão vegetal e a argila ao local.";
		}
		{
			String _name = "text2";
			String _text = "Depois disso, um Construtor fará o forno de fundição com a argila. No forno, eles adicionarão minério e carvão vegetal em camadas alternadas. O forno é aceso logo no início, conforme as camadas são adicionadas; os construtores realizarão a maior parte do trabalho, perfurando um orifício para deixar escapar a escória indesejada e, quando concluído, iniciarão a demolição.";
		}
		{
			String _name = "text3";
			String _text = "Uma vez terminado isso, um Ferreiro extrairá o bloom";
		}
		{
			String _name = "text4";
			String _text = "do forno, e trabalhá-lo para criar o produto final.";
		}
		{
			String _name = "text5";
			String _text = "Um Forno de Fundição precisará ser demolido assim que o Ferreiro tiver concluído o processamento do Ferro.";
		}
		{
			String _name = "text5copper";
			String _text = "Um Forno de Fundição precisará ser demolido assim que o Ferreiro tiver concluído o processamento do Cobre.";
		}
		{
			String _name = "IronRequire";
			String _text = "Ferro - o mais comum e utilizado dos metais; o Ferro tem seu próprio limite para controlar a produção. Usado de forma importante como material para produzir Ferramentas, também é usado na construção de edifícios.";
		}
		{
			String _name = "CopperRequire";
			String _text = "Cobre - produzido sob o limite de Metais, Ligas e Forjados para controlar a produção. Seus usos são principalmente na construção de edifícios, embora também possa ser usado para fazer Ferramentas e Utensílios de Cobre.";
		}
		{
			String _name = "BronzeRequire";
			String _text = "Bronze - produzido sob o limite de Metais, Ligas e Forjados para controlar a produção. Usado como um produto inicial para fazer Ferramentas, também usado na construção.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Pressione para demolir e iniciar a limpeza do local.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "O forno de fundição expirou; o trabalho de limpeza do local já começou. Quando isso for concluído, você poderá remover a base antiga do forno.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Pare a remoção de recursos e pare de destruir este forno de fundição.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Remover";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Agora que você finalmente está pronto para remover e limpar após o forno de fundição:";
		}
		{
			String _name = "text6";
			String _text = "Opa! Os construtores deixaram para trás a base do forno de fundição usado; pressione o botão para removê-la.";
		}
	]

}
