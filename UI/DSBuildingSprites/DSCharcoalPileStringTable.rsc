StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "A queima de carvão vegetal é iniciada pelos Trabalhadores da vila; eles limparão tudo da área e, em seguida, entregarão as Toras ao local.";
		}
		{
			String _name = "text2";
			String _text = "Depois disso, um Construtor preparará e colocará as Toras em uma grande pilha de madeira, cobrirá tudo com um pouco de solo e, antes de fechar completamente, acenderá a pilha.";
		}
		{
			String _name = "text3";
			String _text = "Uma vez concluído o processo de carbonização, um Carvoeiro";
		}
		{
			String _name = "text4";
			String _text = "garantirá que a pilha esteja apagada e extrairá o Carvão Vegetal.";
		}
		{
			String _name = "text5";
			String _text = "Pilhas de Carvão Vegetal são perigosas, fedorentas e esfumaçantes. Elas são mais adequadas fora das vilas, dentro de florestas ou longe de outros edifícios.";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "Carvão Vegetal - Combustível Metalúrgico, mas também usado em algumas residências. Quando usado na ferraria, é capaz de queimar nas temperaturas muito altas necessárias para derreter metais sólidos.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Pressione para demolir e iniciar a limpeza do local.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "A pilha de carvão vegetal expirou; o trabalho de limpeza do local já começou. Quando isso for concluído, você poderá remover as cinzas indesejadas restantes.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Pare a remoção de recursos e pare de destruir esta pilha de carvão vegetal.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Remover";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Agora que você finalmente está pronto para remover e limpar após a pilha de carvão vegetal:";
		}
		{
			String _name = "text6";
			String _text = "Opa! Os construtores deixaram para trás as cinzas usadas da pilha de carvão vegetal; pressione o botão para removê-las.";
		}
	]

}
