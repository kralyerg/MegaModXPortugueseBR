		{ String _name = "NMT30MCrockQuarryLvl5LWR";		String _text = "pedreira de rocha nív.5"; }
		{ String _name = "NMT30MCrockQuarryLvl5Tip";		String _text = "Uma Pedreira de Rocha Nív.5 é uma área de trabalho onde você pode extrair Pedra, Carvão Mineral ou Sal."; }

		{ String _name = "NMT30MCrandomQuarryLvl5";		String _text = "Pedreira Aleatória Nív.5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5LWR";		String _text = "pedreira aleatória nív.5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5Tip";		String _text = "Uma Pedreira Aleatória Nív.5 é uma área de trabalho onde você pode extrair de tudo... aleatoriamente."; }

		{ String _name = "NMT30Foundry";			String _text = "Fundição"; }
		{ String _name = "NMT30FoundryLWR";			String _text = "fundição"; }
		{ String _name = "NMT30FoundryTip";			String _text = "Uma Fundição é uma área de trabalho onde você pode fundir tudo. Tamanho: 8x8 quadrados. Custo: 24 toras, 64 pedras, 18 ferros, 32 carvões vegetais. Pode Criar: 1-2 de ferro, cobre, prata ou ouro por trabalho. Emprego: 1-2 ferreiros. Dicas: A Fundição é o melhor caminho para fundir tudo no jogo e também é mais eficiente que as construções simples de ferreiro."; }

		{ String _name = "NMT30JewelMaker";			String _text = "Fabricante de Joias"; }
		{ String _name = "NMT30JewelMakerLWR";			String _text = "fabricante de joias"; }
		{ String _name = "NMT30JewelMakerTip";			String _text = "Um Fabricante de Joias pega metais preciosos e gemas para confeccionar anéis, colares e joias muito valiosos. Tamanho: 6x6 quadrados. Custo: 8 toras, 24 madeiras serradas, 16 pedras, 18 tijolos, 6 vidros. Pode produzir: joias a partir de gemas lapidadas e ouro/prata, múltiplas receitas. Emprego: 1 trabalhador. Dicas: Você precisa de um lapidador de gemas para cortar essas gemas e, uma vez determinado o valor delas, pode usá-las para fazer uma versão prateada ou dourada. Cada receita produzirá mais de um item por vez. No entanto, a falta de educação prejudica bastante esta construção. A lista de receitas é longa demais para colocar aqui."; }

		{ String _name = "NMT30GemCutter";			String _text = "Lapidador de Gemas"; }
		{ String _name = "NMT30GemCutterLWR";			String _text = "lapidador de gemas"; }
		{ String _name = "NMT30GemCutterTip";			String _text = "Um Lapidador de Gemas pega gemas, as lapida e determina sua qualidade e valor. Tamanho: 6x6 quadrados. Custo: 8 toras, 24 madeiras serradas, 16 pedras, 18 tijolos, 6 vidros. Pode produzir: ametista (valor 60), topázio (valor 80), esmeralda (valor 250), safira (valor 300), rubi (valor 400), diamante (valor 1000). Emprego: 1 trabalhador. Dicas: A única forma de conseguir gemas brutas é na pedreira aleatória. É claro que valores mais altos são bem mais raros que os comuns."; }

		{ String _name = "NMT30CandleMaker";			String _text = "Fabricante de Velas"; }
		{ String _name = "NMT30CandleMakerLWR";			String _text = "fabricante de velas"; }
		{ String _name = "NMT30CandleMakerTip";			String _text = "Um Fabricante de Velas produz Velas a partir de Cera de Abelha. Tamanho: 6x6 quadrados. Custo: 12 toras, 24 madeiras serradas, 18 pedras, 24 tijolos, 12 vidros. Pode produzir: 3-4 velas a partir de 16 de cera de abelha por trabalho. Emprego: 1 trabalhador. Dicas: A Vela tem valor 8. Velas são usadas para melhorar e renovar minas e pedreiras uma vez esgotadas."; }

		{ String _name = "NMT30MineUpgradeTip";			String _text = "Melhore e renove esta mina/pedreira para outro nível mais profundo, o que permitirá que você continue obtendo recursos dela mesmo esgotada. Você precisará de material extra, como velas, para isso."; }

		{ String _name = "RKGardenWallsGreenHouse";			String _text = "Estufa"; }
		{ String _name = "RKGardenWallsGreenHouseLwr";			String _text = "estufa"; }
		{ String _name = "RKGardenWallsGreenHouseTip";			String _text = "Uma Estufa é a fornecedora de comida mais poderosa deste mod. Tamanho: 5x7 quadrados. Custo: 20 madeiras serradas, 20 pedras, 48 vidros. Pode produzir: todo tipo de vegetais do jogo e algumas pequenas plantas frutíferas, números produzidos variam de 16-24 a 20-28. Emprego: 1 botânico. Dicas: A estufa precisa de (2) fertilizante e (2) água ao longo do tempo por trabalho concluído (a melhor fonte de fertilizante é o estábulo; pastagens com alguns animais também ajudam bastante. A água vem de um poço de água ou torre de água)."; }

		{ String _name = "RKGardenWallsStables";			String _text = "Estábulos"; }
		{ String _name = "RKGardenWallsStablesLwr";			String _text = "estábulos"; }
		{ String _name = "RKGardenWallsStablesTip";			String _text = "Estábulos são a melhor fonte de fertilizante do jogo. Tamanho: 9x6 quadrados. Custo: 20 madeiras serradas, 40 pedras. Pode criar: 3-5 de fertilizante (valor 2) a partir de 2 forragens-colmo e 2 águas por trabalho concluído. Emprego: 1-2 cavalariços. Dicas: Você precisa de uma boa fonte de forragem-colmo, que pode vir de desmatamento ou do fazendeiro de forragem, e água de um poço de água ou torre de água. Fertilizante é usado em estufas (o gerador de comida mais poderoso por quadrado)."; }

		{ String _name = "RKGardenWallsWell";				String _text = "Poço de Água"; }
		{ String _name = "RKGardenWallsWellLwr";			String _text = "poço de água"; }
		{ String _name = "RKGardenWallsWellTip";			String _text = "Um Poço de Água é uma boa fonte de água fresca. Tamanho: 1x1 quadrados (3x3 com estradas). Custo: 4 madeiras serradas, 24 pedras. Pode produzir: 12-15 de água (valor 1) por trabalho concluído. Emprego: 1 trabalhador. Dicas: Este poço NÃO PODE ser usado para combate a incêndios. Ele produz água mais lentamente que a torre de água. Água é uma comida sem nutrientes (sem sinalizadores de dieta) e é necessária em muitas indústrias, como estábulos, estufas, perfumaria, boticário..."; }

		{ String _name = "RKGardenWallsFodderFarmers";			String _text = "Fazendeiros de Forragem"; }
		{ String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "fazendeiros de forragem"; }
		{ String _name = "RKGardenWallsFodderFarmersTip";		String _text = "Os Fazendeiros de Forragem plantam grama e colhem forragem-colmo quando a grama estiver totalmente crescida (em vez de árvores). Tamanho: 5x6 quadrados. Custo: 32 madeiras serradas, 4 pedras. Pode produzir: 3-4 de forragem-colmo por trecho de grama colhido. Raio: 26 quadrados. Emprego: 1-3 silvicultores. Dicas: Funciona exatamente como o sítio de silvicultor, mas planta grama. Primeiro, eles precisam limpar tudo no seu raio; remover todas as árvores e minérios ajuda bastante. Depois de removido, eles plantam um trecho de grama. Essa grama precisa crescer e, quando madura, será colhida. A forragem também pode ser usada para fazer feixes de lenha."; }

		{ String _name = "RKGardenWallsFlorist";			String _text = "Florista"; }
		{ String _name = "RKGardenWallsFloristLwr";			String _text = "florista"; }
		{ String _name = "RKGardenWallsFloristTip";			String _text = "Um Florista vagueia e tenta coletar flores. Tamanho: 5x6 quadrados. Custo: 32 madeiras serradas, 4 pedras. Pode produzir: 3-5 de flores por trecho de flores colhido. Raio: 32. Emprego: 1 coletor. Dicas: O florista age exatamente como um coletor, mas procura flores e mudas. Não é indicado para ser posicionado perto da combinação silvicultor/coletor (muito ruim), mas sim para ser usado em conjunto com a construção do fazendeiro de forragem. A grama gera muitas flores. Aviso: eles não plantam flores."; }

		{ String _name = "RKGardenWallsPerfumery";			String _text = "Perfumaria"; }
		{ String _name = "RKGardenWallsPerfumeryLwr";			String _text = "perfumaria"; }
		{ String _name = "RKGardenWallsPerfumeryTip";			String _text = "Uma Perfumaria cria perfume a partir da essência das flores. Tamanho: 5x5 quadrados. Custo: 24 madeiras serradas, 24 pedras, 8 cobres, 12 vidrarias. Pode produzir: 5-8 de perfumes (valor 8) a partir de 8 de flores, 2 de água, 1 de vidraria por trabalho concluído. Emprego: 1 trabalhador. Dicas: Um dos melhores itens para vender, que usa algo que podemos encontrar em todo lugar: flores. Esta construção precisa de água e vidraria ao longo do tempo. A água vem de um poço de água ou torre de água, e a vidraria vem do fabricante de vidro."; }

		{ String _name = "RKGardenWallsCustom5Barn";			String _text = "Celeiro de Forragem"; }
		{ String _name = "RKGardenWallsCustom5BarnLwr";			String _text = "celeiro de forragem"; }
		{ String _name = "RKGardenWallsCustom5BarnTip";			String _text = "Este é um Celeiro de Forragem que só permite armazenar itens de forragem e tudo que se encaixa nessa categoria. Tamanho: 4x4 quadrados. Custo: 12 toras, 28 forragens-colmo. Capacidade: 6000 de peso. Aceita: Itens Diversos. Dicas: Forragem tem a sinalização Diversos, por isso permite todos os itens com essa sinalização. Permite armazenar muito mais itens em um 4x4 do que um depósito simples."; }

		{ String _name = "RKGardenWallsTrash";				String _text = "Descartar"; }
		{ String _name = "RKGardenWallsTrashLwr";			String _text = "descartar"; }
		{ String _name = "RKGardenWallsTrashTip";			String _text = "Descarte este item e remova-o."; }
		{ String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "Descarte este item e remova-o."; }

		{ String _name = "OldBarnPub";				String _text = "Antigo Celeiro-Bar"; }
		{ String _name = "OldBarnPubLWR";			String _text = "antigo celeiro-bar"; }
		{ String _name = "OldBarnPubTip";			String _text = "Um Antigo Celeiro-Bar é um celeiro convertido em bar ou taverna. Eles servirão refeições e bebidas, e terão um ambiente festivo que proporcionará felicidade. Tamanho: 6x6 quadrados. Custo: 32 toras, 16 pedras. Felicidade: Entretenimento. Raio: 40 quadrados. Emprego: 1-3 cervejeiros. Dicas: Esta construção usa uma nova sinalização: Consumo. Essa sinalização especial ajuda a lidar com bebidas alcoólicas e age da mesma forma. Os cervejeiros pegam carne de nível 2, mais um vegetal e uma bebida alcoólica, e produzem 12-16 refeições (valor 1). Os cidadãos pegam as refeições e ganham felicidade com isso (exatamente como o ale), mas custa bem menos."; }


		{ String _name = "ClearWildFood";			String _text = "Coletar Comida Selvagem"; }
		{ String _name = "ClearWildFoodLwr";			String _text = "coletar comida selvagem"; }
		{ String _name = "ClearWildFoodTip";			String _text = "Colete e colha os pontos de comida selvagem na área selecionada. Dicas: Comida selvagem aparece a partir de árvores, e muitas comidas novas aparecem a partir de flores."; }

		{ String _name = "ClearFodder";				String _text = "Coletar Forragem"; }
		{ String _name = "ClearFodderLwr";			String _text = "coletar forragem"; }
		{ String _name = "ClearFodderTip";			String _text = "Colete e colha os trechos de forragem-colmo na área selecionada. Dicas: Forragem-colmo é o material que você obtém ao colher os trechos de grama visíveis no chão. A forragem pode ser usada nos estábulos, transformada em feixes de lenha (por lenhadores) ou usada como material de construção (apiário, pastagem sem cerca, celeiro de forragem...). Cada trecho de grama gera 4-6 de forragem-colmo (valor 1). Esses itens são armazenados em um depósito de construção."; }

		{ String _name = "ClearFlower";				String _text = "Coletar Flores"; }
		{ String _name = "ClearFlowerLwr";			String _text = "coletar flores"; }
		{ String _name = "ClearFlowerTip";			String _text = "Colete e colha os pontos de flores na área selecionada. Dicas: Flores têm a sinalização diversos. Cada trecho de flores gera 3-5 de flores (valor 1). Certifique-se de ter celeiros que aceitem itens diversos."; }

		{ String _name = "ClearHerb";				String _text = "Coletar Ervas"; }
		{ String _name = "ClearHerbLwr";			String _text = "coletar ervas"; }
		{ String _name = "ClearHerbTip";			String _text = "Colete e colha os pontos de ervas na área selecionada. Dicas: Ervas são usadas em um herbalista (ou casa de banho) para recuperar 1/2 coração por uso. Cada trecho de ervas gera 2-3 de ervas (valor 4). Ervas exigem armazenamento do tipo celeiro."; }

		{ String _name = "ClearCopper";				String _text = "Coletar Cobre"; }
		{ String _name = "ClearCopperLwr";			String _text = "coletar cobre"; }
		{ String _name = "ClearCopperTip";			String _text = "Colete todo o cobre e outros minerais raros (ouro e prata) na área selecionada. Dicas: Cobre é usado para fazer algumas ferramentas e também como material de construção. Cobre e os outros minérios raros são minerais. Certifique-se de ter um depósito de materiais disponível. 2-3 de minério de cobre são extraídos (valor 4), 1-2 de minério de prata (valor 11) ou 1-2 de minério de ouro (valor 22). Certifique-se de ter um depósito de minerais disponível para armazená-los."; }

		{ String _name = "ClearAlmostAll";			String _text = "Coletar Quase Tudo"; }
		{ String _name = "ClearAlmostAllLwr";			String _text = "coletar quase tudo"; }
		{ String _name = "ClearAlmostAllTip";			String _text = "Colete todos os minérios e pedras na área selecionada. Dicas: Esta ferramenta especial coleta todos os minérios e todas as pedras. Não removerá árvores, grama e outras coisas selvagens valiosas. Muito útil para limpar rapidamente todas as terras ao redor dos silvicultores."; }

		{ String _name = "ClearFirewood";			String _text = "Coletar Madeira Morta"; }
		{ String _name = "ClearFirewoodLwr";			String _text = "coletar madeira morta"; }
		{ String _name = "ClearFirewoodTip";			String _text = "Colete toda a madeira morta na área selecionada para lenha. Dicas: Madeira morta são árvores mortas caídas. Colher um ponto de madeira morta gera 5-8 de lenha por árvore morta."; }

		{ String _name = "BostonHouse";				String _text = "Casa de Boston"; }
		{ String _name = "BostonHouseLwr";			String _text = "casa de boston"; }
		{ String _name = "BostonHouseTip";			String _text = "Casa de Boston. Todo cidadão adoraria morar em uma colorida Casa de Boston. Tamanho: 4x5 quadrados. Custo: 54 madeiras serradas, 6 pedras e 30 vidros. Residência: 6 cidadãos. EFI. de Calor%: 108. Modelos: 1. Cores: 8 alternativas. Dicas: Pressione F para mudar a cor."; }

		{ String _name = "BostonHouse2";			String _text = "Casa de Boston 2"; }
		{ String _name = "BostonHouse2Lwr";			String _text = "casa de boston 2"; }
		{ String _name = "BostonHouse2Tip";			String _text = "Casa de Boston 2 (texturas e modelos diferentes). Todo cidadão adoraria morar em uma colorida Casa de Boston. Tamanho: 4x5 quadrados. Custo: 54 madeiras serradas, 6 pedras e 30 vidros. Residência: 6 cidadãos. EFI. de Calor%: 108. Modelos: 1. Cores: 10 alternativas. Dicas: Pressione F para mudar a cor."; }

		{ String _name = "LittleHouseToolbar";			String _text = "Barra de Ferramentas Pequena Casa Colorida"; }
		{ String _name = "LittleHouseToolbarLwr";		String _text = "barra de ferramentas pequena casa colorida"; }
		{ String _name = "LittleHouseToolbarTip";		String _text = "Abra esta barra de ferramentas para ver as opções da Pequena Casa Colorida. Dicas: Este é um conjunto que contém um primeiro andar e um 2º andar especial para ficar sobre o primeiro andar, destinado a uma segunda família. Eles terão 5 ocupantes e EFI. de Calor% de 80. 12 cores diferentes. Pressione F para mudar a cor."; }

		{ String _name = "LittleHouse01";			String _text = "Pequena Casa Colorida"; }
		{ String _name = "LittleHouse01Lwr";			String _text = "pequena casa colorida"; }
		{ String _name = "LittleHouse01Tip";			String _text = "Uma Pequena Casa Colorida é usada para abrigar seus cidadãos. Tamanho: 3x5 quadrados. Custo: 24 toras, 6 pedras. Residência: 5 cidadãos. EFI. de Calor%: 80. Modelos: 1. Cores: 12 alternativas. Dicas: Pressione F para mudar a cor."; }

		{ String _name = "LittleHouse01floor2";			String _text = "Pequena Casa Colorida 2º Andar"; }
		{ String _name = "LittleHouse01floor2Lwr";		String _text = "pequena casa colorida 2º andar"; }
		{ String _name = "LittleHouse01floor2Tip";		String _text = "Um 2º Andar Colorido é usado para abrigar uma segunda família. Tamanho: 1x5 quadrados. Custo: 32 toras, 6 pedras. Residência: 6 cidadãos. EFI. de Calor%: 90. Modelos: 1. Cores: 12 alternativas. Dicas: Fica logo à direita do primeiro andar; certifique-se de alinhar as chaminés na parte de trás. Precisa encaixar perfeitamente sobre o 1º andar. Pressione F para mudar a cor."; }


