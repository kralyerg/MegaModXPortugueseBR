		{ String _name = "HostelToolbar";			String _text = "Barra de Ferramentas Pousada de Esquina"; }
		{ String _name = "HostelToolbarLwr";			String _text = "barra de ferramentas pousada de esquina"; }
		{ String _name = "HostelToolbarTip";			String _text = "Barra de Ferramentas Pousada de Esquina. Abra esta barra de ferramentas para ver as opções da Pousada de Esquina. Dicas: Pousadas de Esquina são construções de 3 andares. Vêm em diferentes formatos, custos e texturas, mas sempre no mesmo tamanho: 1x5 + 5x5 + 1x5. O 2º andar fica à direita do 1º andar, o 3º andar fica à esquerda (relativa) do 1º andar. Têm capacidade para 3 famílias de 5 ocupantes e uma faixa de EFI. de Calor% de 72 a 114."; }

		{ String _name = "HostelF1C1T1";			String _text = "Pousada 1º Andar"; }
