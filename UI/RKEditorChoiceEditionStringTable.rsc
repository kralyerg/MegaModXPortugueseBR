		{ String _name = "NMT30MCrandomQuarryLvl4LWR";		String _text = "pedreira aleatória nív.4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4Tip";		String _text = "Uma Pedreira Aleatória Nív.4 é uma área de trabalho onde você pode extrair de tudo... aleatoriamente."; }

		{ String _name = "NMT30MCironQuarryLvl5";		String _text = "Pedreira de Ferro Nív.5"; }
		{ String _name = "NMT30MCironQuarryLvl5LWR";		String _text = "pedreira de ferro nív.5"; }
		{ String _name = "NMT30MCironQuarryLvl5Tip";		String _text = "Uma Pedreira de Ferro Nív.5 é uma área de trabalho onde você pode extrair Ferro ou Cobre."; }

