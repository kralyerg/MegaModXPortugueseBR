		{ String _name = "NMT20AleStand";			String _text = "Barraca de Ale"; }
		{ String _name = "NMT20AleStandLwr";			String _text = "barraca de ale"; }
		{ String _name = "NMT20AleStandTip";			String _text = "A Barraca de Ale pega todas as suas bebidas alcoólicas e as oferece aos seus cidadãos. Tamanho: 4x3. Custo: 16 toras. Capacidade: 3000 de peso. Raio: 20 quadrados. Emprego: 1-2 cervejeiros. Dicas: Os cervejeiros vão circular e pegar todas as bebidas alcoólicas da cidade para encher sua barraca. Os cidadãos podem pegar bebidas alcoólicas e ganhar (0,05%) de felicidade com isso."; }

		{ String _name = "NMT30CharcoalKiln";			String _text = "Forno de Carvão"; }
		{ String _name = "NMT30CharcoalKilnLwr";		String _text = "forno de carvão"; }
		{ String _name = "NMT30CharcoalKilnTip";		String _text = "O Forno de Carvão pega lenha e transforma em carvão vegetal. Tamanho: 6x6. Custo: 12 toras, 32 pedras. Pode produzir: 18-24 de carvão vegetal a partir de 12 de lenha. Emprego: 1-2 trabalhadores. Dicas: Dobra a quantidade de combustível e fornece combustível suficiente para o dobro de moradias em comparação com a lenha."; }

		{ String _name = "NMT30FurnitureMaker";			String _text = "Fabricante de Móveis"; }
		{ String _name = "NMT30FurnitureMakerLwr";		String _text = "fabricante de móveis"; }
		{ String _name = "NMT30FurnitureMakerTip";		String _text = "O Fabricante de Móveis pega madeira serrada, madeira e alguns metais caros e produz belos móveis. Tamanho: 8x9. Custo: 34 toras, 48 madeiras serradas, 32 pedras, 24 ferros, 8 vidros. Pode produzir: móveis, móveis finos, móveis prateados, móveis dourados. Emprego: 1-2 trabalhadores. Dicas: Produz alguns dos melhores recursos de venda para o final do jogo."; }

		{ String _name = "NMT30WeaponMaker";			String _text = "Fabricante de Armas"; }
		{ String _name = "NMT30WeaponMakerLwr";			String _text = "fabricante de armas"; }
		{ String _name = "NMT30WeaponMakerTip";			String _text = "O Fabricante de Armas pega ferro, madeira e alguns metais caros e produz armas mortais. Tamanho: 7x9. Custo: 28 toras, 42 madeiras serradas, 38 pedras, 36 ferros, 4 vidros. Pode produzir: arma, arma fina, arma nobre, arma real. Emprego: 1-2 ferramenteiros. Dicas: Produz alguns dos melhores recursos de venda para o final do jogo."; }

		{ String _name = "NMT30ArmorMaker";			String _text = "Fabricante de Armaduras"; }
