		{ String _name = "OrchardLodges2ToolbarTip";		String _text = "Barra de Ferramentas de Sítios Tropicais. Abra esta barra de ferramentas para ver as opções de Sítios de Pomar Tropical. (Usado para definir uma área onde as árvores serão seletivamente cortadas e novas mudas de árvores frutíferas tropicais serão plantadas. Custo: 32 madeiras, 12 pedras. Raio: 24 quadrados. Emprego: 1-2 silvicultores.)"; }

		{ String _name = "OrchardLodgeAppleTree";		String _text = "Sítio de Maçã"; }
		{ String _name = "OrchardLodgeAppleTreeLwr";		String _text = "sítio de maçã"; }
		{ String _name = "OrchardLodgeAppleTreeTip";		String _text = "Usado para definir uma área onde as árvores serão seletivamente cortadas e novas mudas de maçã serão plantadas. Tamanho: 5x6. Custo: 32 toras, 12 pedras. Raio: 24 quadrados. Emprego: 1-2 silvicultores. Dicas: Tudo será removido e substituído por uma árvore de maçã, que produzirá cestos de maçãs ao longo do tempo. É como um pomar, mas organizado como um sítio de silvicultor."; }

