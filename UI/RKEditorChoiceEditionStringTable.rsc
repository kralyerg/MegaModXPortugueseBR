		{ String _name = "OrchardLodgesToolbar";		String _text = "Barra de Ferramentas de Sítios de Pomar"; }
		{ String _name = "OrchardLodgesToolbarLwr";		String _text = "barra de ferramentas de sítios de pomar"; }
		{ String _name = "OrchardLodgesToolbarTip";		String _text = "Barra de Ferramentas de Sítios de Pomar. Abra esta barra de ferramentas para ver as opções de Sítios de Pomar. (Usado para definir uma área onde as árvores serão seletivamente cortadas e novas mudas de árvores frutíferas serão plantadas. Custo: 32 madeiras, 12 pedras. Raio: 24 quadrados. Emprego: 1-2 silvicultores.)"; }

		{ String _name = "OrchardLodges2Toolbar";		String _text = "Barra de Ferramentas de Sítios Tropicais"; }
