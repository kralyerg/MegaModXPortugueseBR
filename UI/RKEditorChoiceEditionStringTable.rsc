		{ String _name = "NMT30MCrandomQuarryLvl2LWR";		String _text = "pedreira aleatória nív.2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2Tip";		String _text = "Uma Pedreira Aleatória Nív.2 é uma área de trabalho onde você pode extrair de tudo... aleatoriamente."; }

