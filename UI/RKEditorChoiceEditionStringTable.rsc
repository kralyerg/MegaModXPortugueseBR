		{ String _name = "PastureFencelessLwr";			String _text = "pastagem sem cerca"; }
		{ String _name = "PastureFencelessTip";			String _text = "Uma Pastagem Sem Cerca fornece uma área para o gado pastar. Tamanho: de 7x7 a 30x30. Custo: 1 forragem-colmo por quadrado. Emprego: 1-4 pastores. Dicas: Use R ou T para girar a pastagem e garantir que o abrigo dos animais fique o mais próximo possível dos celeiros e em uma encosta."; }

		{ String _name = "MarketMed";				String _text = "Mercado"; }
		{ String _name = "MarketMedLwr";			String _text = "mercado"; }
		{ String _name = "MarketMedTip";			String _text = "Usado para fornecer uma área localizada para os cidadãos coletarem comida, ferramentas e combustível. Tamanho: 10x10. Custo: 32 madeiras serradas, 30 pedras, 22 ferros. Capacidade: 12000 de peso. Raio: 36 quadrados. Armazena: Comestíveis, Combustível, Ferramentas, Saúde, Roupas. Emprego: 1-8 vendedores. Dicas: Um dos melhores para fornecer bens às casas dos cidadãos. Menor que o grande."; }

		{ String _name = "RKFCLumbermill";			String _text = "Serraria"; }
		{ String _name = "RKFCLumbermillLwr";			String _text = "serraria"; }
		{ String _name = "RKFCLumbermillTip";			String _text = "A Serraria é usada para produzir Madeira Serrada a partir de Toras. Tamanho: 5x6. Custo: 48 toras, 6 pedras. Pode produzir: Madeira Serrada, lenha. Emprego: 1-3 lenhadores. Dicas: A Serraria é uma construção inicial do assentamento; todas as construções de nível 2+ exigirão madeira serrada. Também pode produzir lenha, se necessário. Pressione F para cores alternativas do telhado."; }

		{ String _name = "RKFCForestBarn";			String _text = "Celeiro Florestal"; }
		{ String _name = "RKFCForestBarnLwr";			String _text = "celeiro florestal"; }
		{ String _name = "RKFCForestBarnTip";			String _text = "Um Celeiro Florestal pode armazenar tudo o que vem dos postos avançados florestais. Tamanho: 5x6. Custo: 48 toras, 12 pedras. Capacidade: 12000 de peso. Aceita: Comestíveis, Ferramentas, Saúde, Combustível, Madeira, Têxteis, Grãos, Vegetais, Frutas, Proteínas. Dicas: Muito útil para armazenar bens simples vindos de postos avançados florestais."; }

		{ String _name = "TradingPostSeeds";			String _text = "PC Sementes e Gado"; }
		{ String _name = "TradingPostSeedsLwr";			String _text = "pc sementes e gado"; }
		{ String _name = "TradingPostSeedsTip";			String _text = "Permite o comércio de recursos apenas com comerciantes de sementes/gado. Tamanho: 8x11. Custo: 48 toras, 32 pedras, 12 ferros. Capacidade: 30000 de peso. Aceita: Madeira, Pedra, Ferro, Combustível, Ferramentas, Têxteis, Roupas, Minerais, Artesanatos, Forjados, Tecidos, Industriais, Materiais, Construção, Preciosos, Diversos. Emprego: 1-10 comerciantes. Dicas: Comerciantes de gado e sementes não aceitam ervas nem comida."; }

		{ String _name = "RKWoodBakery";				String _text = "Padaria"; }
		{ String _name = "RKWoodBakeryLwr";				String _text = "padaria"; }
		{ String _name = "RKWoodBakeryTip";				String _text = "A padaria medieval pega farinha e produz pão, bolos e tortas. Tamanho: 5x6. Custo: 32 madeiras serradas, 16 pedras, 24 carvões vegetais, 6 vidros. Pode produzir: pão, bolo, tortas, quiche, omelete. Emprego: 1-2 padeiros. Dicas: Ótima para produzir comida de nível 2. As padarias usarão várias quantidades de comida e de farinha e tentarão fornecer (+100% educados, +50% não educados) mais comida no total. E algumas comidas têm mais de 1 tipo de dieta."; }

		{ String _name = "NMT30Windmill";				String _text = "Moinho de Vento"; }
		{ String _name = "NMT30WindmillLwr";				String _text = "moinho de vento"; }
		{ String _name = "NMT30WindmillTip";				String _text = "O moinho de vento medieval produz farinha a partir de grãos. Tamanho: 6x6. Custo: 48 madeiras serradas, 42 pedras, 32 ferros. Pode produzir: farinha a partir de trigo, milho, cevada, sorgo, aveia, centeio, arroz. Emprego: 1-2 moleiros. Dicas: Pressione F para modelos alternativos. Eles pegam 16 grãos e produzem 24-32 de farinha. +100% educ., +50% não educ."; }

		{ String _name = "NMT30Watermill";				String _text = "Moinho de Água"; }
		{ String _name = "NMT30WatermillLwr";				String _text = "moinho de água"; }
		{ String _name = "NMT30WatermillTip";				String _text = "O moinho de água medieval produz farinha a partir de grãos. Tamanho: 9x7. Custo: 48 madeiras serradas, 42 pedras, 32 ferros. Pode produzir: farinha a partir de trigo, milho, cevada, sorgo, aveia, centeio, arroz. Emprego: 1-3 moleiros. Dicas: Esta construção exige alguns quadrados de água. Trabalha mais rápido que o moinho de vento. Eles pegam 16 grãos e produzem 24-32 de farinha. +100% educ., +50% não educ."; }

		{ String _name = "NMT30Apiary";					String _text = "Apiário"; }
		{ String _name = "NMT30ApiaryLwr";				String _text = "apiário"; }
		{ String _name = "NMT30ApiaryTip";				String _text = "O Apiário medieval é usado para criar abelhas e gerar mel e cera de abelha. Tamanho: 6x6. Custo: 16 toras, 24 forragens-colmo. Pode produzir: mel (comida), cera de abelha (velas). Emprego: 1-2 apicultores. Dicas: Esta construção de comida fornece, logo no início do jogo, uma ótima fonte constante de comida. Você também precisará dela para fazer cera de abelha e produzir velas para melhorar suas minas e pedreiras esgotadas."; }

		{ String _name = "WoodButcher";					String _text = "Açougue"; }
		{ String _name = "WoodButcherLwr";				String _text = "açougue"; }
		{ String _name = "WoodButcherTip";				String _text = "O Açougue corta carnes e produz comida de nível 2. Tamanho: 4x6. Custo: 48 madeiras serradas, 42 pedras, 32 ferros. Pode produzir: carnes preparadas de nível 2 (bifes, assados, costeletas e aves). Emprego: 1-2 açougueiros. Dicas: Ótima construção para pegar suas carnes cruas e carnes de aves cruas e processá-las, dobrando suas quantidades de proteína. De 12 de carne, você obtém 18-24 de bife (educados = +100%) (não educados = apenas +50%)."; }

		{ String _name = "NMT30LightHouse";				String _text = "Farol"; }
		{ String _name = "NMT30LightHouseLwr";				String _text = "farol"; }
		{ String _name = "NMT30LightHouseTip";				String _text = "Um Farol oferecerá estatísticas da cidade e atrairá nômades de longe. Tamanho: 11x8. Custo: 58 madeiras serradas, 98 pedras, 14 ferros, 16 cobres, 24 vidros, 32 lenhas. Emprego: 1 fogueiro. Dicas: O fogueiro cuidará do fogo no topo para que você possa atrair nômades. O Farol oferece todos os serviços que uma prefeitura pode fornecer."; }

		{ String _name = "NMT30Watertower";				String _text = "Torre de Água"; }
		{ String _name = "NMT30WatertowerLwr";				String _text = "torre de água"; }
		{ String _name = "NMT30WatertowerTip";				String _text = "Uma Torre de Água fornece água fresca aos seus cidadãos. Tamanho: 4x5. Custo: 34 toras, 8 ferros. Pode produzir: 12-15 de água a partir da torre de água. Emprego: 1-2 trabalhadores. Dicas: A água serve como comida, mas não tem nutrientes. Algumas construções (como as estufas) precisam de Água ao longo do tempo como insumo."; }

		{ String _name = "NMT30Cathedral";				String _text = "Catedral"; }
		{ String _name = "NMT30CathedralLwr";				String _text = "catedral"; }
		{ String _name = "NMT30CathedralTip";				String _text = "A Catedral Medieval proporciona felicidade aos devotos e um lugar para se reunir e adorar. Tamanho: 12x20. Custo: 90 madeiras serradas, 160 pedras, 64 vidros, 18 pratas, 12 ouros, 80 telhas. Capacidade: 800 almas. Raio: 60 quadrados. Emprego: 1 clérigo. Dicas: Muitas cidades deveriam ter uma Catedral magnífica! Mas nem todas as têm."; }

		{ String _name = "NMT30SaltMine";				String _text = "Mina de Sal"; }
		{ String _name = "NMT30SaltMineLwr";				String _text = "mina de sal"; }
		{ String _name = "NMT30SaltMineTip";				String _text = "A Mina de Sal é um local de trabalho que fornece sal. Tamanho: 6x6. Custo: 24 toras, 32 madeiras serradas, 12 ferros. Pode extrair: 4-6 de sal do solo. Detração: 20 quadrados. Capacidade: 4000, não renovável. Emprego: 1-5 mineiros. Dicas: Forma mais rápida de obter sal. Sal é um mineral. Quando esgotada, destrua e construa outra."; }

		{ String _name = "NMT30OldSmokery";				String _text = "Antiga Defumaria"; }
		{ String _name = "NMT30OldSmokeryLwr";				String _text = "antiga defumaria"; }
		{ String _name = "NMT30OldSmokeryTip";				String _text = "A Antiga Defumaria é um local de trabalho que pega carnes e as defuma para preservação. Tamanho: 6x6. Custo: 18 madeiras serradas, 48 pedras, 12 ferros, 4 vidros. Pode produzir: carnes preparadas de nível 2 (carnes, peixes e aves defumados). Emprego: 1-2 padeiros. Dicas: Esta construção precisa de +1 lenha para cada processo de defumação. Mas o valor de saída permanece em 3 (não 2). Peixe tem valor 2. Elas pegam 12 de insumo e produzem 18-24 de saída. +100% educ., +50% não educ."; }

		{ String _name = "NMT30OldSaltery";				String _text = "Antiga Salga"; }
		{ String _name = "NMT30OldSalteryLwr";				String _text = "antiga salga"; }
		{ String _name = "NMT30OldSalteryTip";				String _text = "A Antiga Salga é um local de trabalho que pega carnes e as salga para preservação. Tamanho: 6x6. Custo: 36 madeiras serradas, 16 pedras, 8 ferros. Pode produzir: carnes preparadas de nível 2 (carnes, peixes e aves curados). Emprego: 1-2 padeiros. Dicas: Esta construção precisa de +3 de sal para cada processo de cura. Mas o valor de saída permanece em 3 (não 2). Peixe tem valor 2. Elas pegam 12 de insumo e produzem 18-24 de saída. +100% educ., +50% não educ."; }

		{ String _name = "NMT30DryShack";				String _text = "Antigo Barracão de Secagem"; }
		{ String _name = "NMT30DryShackLwr";				String _text = "antigo barracão de secagem"; }
		{ String _name = "NMT30DryShackTip";				String _text = "O Antigo Barracão de Secagem é um local de trabalho que pega carnes e as seca para preservação. Tamanho: 6x6. Custo: 28 madeiras serradas, 6 madeiras, 4 pedras. Pode produzir: carnes preparadas de nível 2 (carnes, peixes e aves secos). Emprego: 1-2 padeiros. Dicas: Esta construção só precisa de carnes. Nenhum outro insumo, mas o valor das carnes perde 1 ponto. Elas pegam 12 de insumo e produzem 18-24 de saída. +100% educ., +50% não educ."; }

		{ String _name = "NMT30Creamery";				String _text = "Antiga Leiteria"; }
		{ String _name = "NMT30CreameryLwr";				String _text = "antiga leiteria"; }
		{ String _name = "NMT30CreameryTip";				String _text = "A Antiga Leiteria é um local de trabalho que pega leite e produz queijo, manteiga, creme e iogurte. Tamanho: 8x8. Custo: 36 madeiras serradas, 24 pedras, 8 vidros, 6 ferros. Pode produzir: carnes preparadas de nível 2 (queijo, manteiga, creme, iogurte). Emprego: 1-2 leiteiros. Dicas: Esta construção precisa principalmente de leite. Você pode adicionar algumas frutas. As saídas são variáveis devido às receitas. A educação é importante nos números de saída."; }

		{ String _name = "RKRedCreamery";				String _text = "Leiteria Vermelha"; }
		{ String _name = "RKRedCreameryLwr";				String _text = "leiteria vermelha"; }
		{ String _name = "RKRedCreameryTip";				String _text = "A Leiteria Vermelha é um local de trabalho que pega leite e produz queijo, manteiga, creme e iogurte. Tamanho: 9x10. Custo: 68 madeiras serradas, 12 pedras, 16 cobres, 8 vidros, 16 vidrarias. Pode produzir: carnes preparadas de nível 2 (queijo, manteiga, creme, iogurte). Emprego: 1-3 leiteiros. Dicas: Esta construção precisa principalmente de leite. Você pode adicionar algumas frutas. As saídas são variáveis devido às receitas. A educação é importante nos números de saída. A leiteria vermelha é bem mais rápida que a antiga leiteria."; }

		{ String _name = "NMT30MaltHouse";				String _text = "Casa de Malte"; }
		{ String _name = "NMT30MaltHouseLwr";				String _text = "casa de malte"; }
		{ String _name = "NMT30MaltHouseTip";				String _text = "A Casa de Malte é um local de trabalho que pega grãos e os converte em malte. Tamanho: 6x8. Custo: 12 toras, 24 madeiras serradas, 48 pedras, 24 tijolos, 8 ferros, 12 vidros. Pode produzir: 18-24 de malte a partir de 12 de grãos (cevada, milho, aveia, centeio, sorgo, trigo). Emprego: 1-2 cervejeiros. Dicas: O antigo ale agora tem valor 6. A cerveja substituiu o ale com valor 8, mas a cerveja precisa de malte. Então agora você precisa converter o grão em malte, e as tavernas irão fermentar o malte."; }

		{ String _name = "NMT30Pond";					String _text = "Lagoa Medieval"; }
		{ String _name = "NMT30PondLwr";				String _text = "lagoa medieval"; }
		{ String _name = "NMT30PondTip";				String _text = "Uma Lagoa Medieval fornece peixe aos seus cidadãos. Tamanho: 8x9. Custo: 4 toras, 12 pedras. Capacidade: Ilimitada. Dicas: Bem independente do cais de pesca tradicional, a Lagoa terá uma saída equivalente. Se você decidir removê-la, precisará usar a ferramenta de nivelamento para deixar o terreno normal novamente."; }

		{ String _name = "StorageBarn";					String _text = "Celeiro de Armazenamento"; }
		{ String _name = "StorageBarnLwr";				String _text = "celeiro de armazenamento"; }
		{ String _name = "StorageBarnTip";				String _text = "Usado para armazenar bens como comida, roupas, têxteis e ferramentas. Tamanho: 5x8. Custo: 48 toras, 16 pedras. Capacidade: 8000 de peso. Aceita: Comestíveis, Ferramentas, Ervas, Roupas, Têxteis, Grãos, Vegetais, Frutas, Proteínas, Artesanatos, Forjados, Tecidos, Preciosos, Diversos. Dicas: Certifique-se de sempre ter espaço no celeiro disponível para armazenar sua comida e outras coisas."; }

		{ String _name = "NMT30StorageBarnNorm";			String _text = "Celeiro Normal"; }
		{ String _name = "NMT30StorageBarnNormLwr";			String _text = "celeiro normal"; }
		{ String _name = "NMT30StorageBarnNormTip";			String _text = "Um Celeiro Normal é usado para armazenar bens como comida, roupas, têxteis e ferramentas. Tamanho: 5x8. Custo: 48 toras, 16 pedras. Capacidade: 10000 de peso. Aceita: Comestíveis, Ferramentas, Ervas, Roupas, Têxteis, Grãos, Vegetais, Frutas, Proteínas, Artesanatos, Forjados, Tecidos, Preciosos, Diversos. Dicas: Este celeiro é exatamente o mesmo que está dentro da barra de ferramentas de armazenamento do jogo."; }

		{ String _name = "NMT30StorageBarnMed";				String _text = "Celeiro Médio"; }
		{ String _name = "NMT30StorageBarnMedLwr";			String _text = "celeiro médio"; }
		{ String _name = "NMT30StorageBarnMedTip";			String _text = "Um Celeiro Médio é usado para armazenar bens como comida, roupas, têxteis e ferramentas. Tamanho: 4x6. Custo: 32 toras, 12 pedras. Capacidade: 6000 de peso. Aceita: Comestíveis, Ferramentas, Ervas, Roupas, Têxteis, Grãos, Vegetais, Frutas, Proteínas, Artesanatos, Forjados, Tecidos, Preciosos, Diversos. Dicas: Este celeiro é uma versão menor do celeiro regular. Mais barato e também de tamanho médio, tem capacidade média."; }

		{ String _name = "NMT30StorageBarnSmall";			String _text = "Celeiro Pequeno"; }
		{ String _name = "NMT30StorageBarnSmallLwr";			String _text = "celeiro pequeno"; }
		{ String _name = "NMT30StorageBarnSmallTip";			String _text = "Um Celeiro Pequeno é usado para armazenar bens como comida, roupas, têxteis e ferramentas. Tamanho: 3x5. Custo: 24 toras, 8 pedras. Capacidade: 3800 de peso. Aceita: Comestíveis, Ferramentas, Ervas, Roupas, Têxteis, Grãos, Vegetais, Frutas, Proteínas, Artesanatos, Forjados, Tecidos, Preciosos, Diversos. Dicas: Este celeiro é uma versão menor do celeiro médio. Mais barato e também de tamanho pequeno, tem capacidade pequena."; }

		{ String _name = "NMT30StorageBarnTiny";			String _text = "Celeiro Minúsculo"; }
		{ String _name = "NMT30StorageBarnTinyLwr";			String _text = "celeiro minúsculo"; }
		{ String _name = "NMT30StorageBarnTinyTip";			String _text = "Um Celeiro Minúsculo é usado para armazenar bens como comida, roupas, têxteis e ferramentas. Tamanho: 2x3. Custo: 16 toras, 4 pedras. Capacidade: 1600 de peso. Aceita: Comestíveis, Ferramentas, Ervas, Roupas, Têxteis, Grãos, Vegetais, Frutas, Proteínas, Artesanatos, Forjados, Tecidos, Preciosos, Diversos. Dicas: Este celeiro é uma versão minúscula do celeiro pequeno. Muito mais barato e também de tamanho minúsculo, tem capacidade minúscula."; }

		{ String _name = "NMT30Granary";				String _text = "Paiol"; }
		{ String _name = "NMT30GranaryLwr";				String _text = "paiol"; }
		{ String _name = "NMT30GranaryTip";				String _text = "Um Paiol é um armazenamento especializado usado para armazenar apenas comida (comestível e não comestível). Tamanho: 5x8. Custo: 58 toras, 16 pedras. Capacidade: 12000 de peso. Aceita: Comestíveis, Grãos, Vegetais, Frutas, Proteínas. Dicas: Este paiol é um tipo de celeiro, mas armazena apenas comida (comestível e não comestível) e tem uma capacidade maior por quadrado. Custa um pouco mais que o celeiro regular."; }

		{ String _name = "NMT30RootCellar";				String _text = "Adega de Raízes"; }
		{ String _name = "NMT30RootCellarLwr";				String _text = "adega de raízes"; }
		{ String _name = "NMT30RootCellarTip";				String _text = "Uma Adega de Raízes é um armazenamento subterrâneo especializado usado para armazenar apenas Frutas/Vegetais. Tamanho: 4x5. Custo: 6 toras, 26 pedras. Capacidade: 8000 de peso. Aceita: Vegetais, Frutas. Dicas: Esta adega de raízes é um tipo de celeiro subterrâneo, mas armazena apenas frutas e vegetais e tem uma capacidade bem maior por quadrado. Custa mais pedras que toras."; }

		{ String _name = "RKmeatLocker";				String _text = "Câmara Frigorífica"; }
		{ String _name = "RKmeatLockerLwr";				String _text = "câmara frigorífica"; }
		{ String _name = "RKmeatLockerTip";				String _text = "Uma Câmara Frigorífica é um armazenamento semi-subterrâneo especializado usado para armazenar apenas Carne/Proteínas. Tamanho: 3x3 quadrados. Custo: 5 toras, 12 pedras. Capacidade: 3600 de peso. Aceita: Proteínas. Dicas: Esta câmara frigorífica é um tipo de celeiro semi-subterrâneo, mas armazena apenas carnes e proteínas e tem uma capacidade bem maior por quadrado. Custa mais pedras que toras."; }

		{ String _name = "NMT30BarberShop";				String _text = "Barbearia"; }
		{ String _name = "NMT30BarberShopLwr";				String _text = "barbearia"; }
		{ String _name = "NMT30BarberShopTip";				String _text = "A Barbearia é um local administrado por um médico que ajudará a manter seus cidadãos saudáveis. Tamanho: 4x5 quadrados. Custo: 8 toras, 24 madeiras serradas, 32 pedras, 8 vidros, 12 perfumes, 1 prata. Atendimento: 10. Emprego: 1 médico. Dicas: Esta é uma versão menor do hospital e funcionará da mesma forma. Aceita apenas 10 pacientes. O design foi feito para caber sob andares multiníveis. Não atrairá ociosos."; }

		{ String _name = "NMT30Dentist";				String _text = "Dentista"; }
		{ String _name = "NMT30DentistLwr";				String _text = "dentista"; }
		{ String _name = "NMT30DentistTip";				String _text = "O Dentista é um local administrado por um médico que ajudará a manter seus cidadãos saudáveis. Tamanho: 4x5 quadrados. Custo: 8 toras, 24 madeiras serradas, 32 pedras, 8 vidros, 6 cobres, 1 ouro. Atendimento: 10. Emprego: 1 médico. Dicas: Esta é uma versão menor do hospital e funcionará da mesma forma. Aceita apenas 10 pacientes. O design foi feito para caber sob andares multiníveis. Não atrairá ociosos."; }

		{ String _name = "NMT30Clinic";					String _text = "Clínica"; }
		{ String _name = "NMT30ClinicLwr";				String _text = "clínica"; }
		{ String _name = "NMT30ClinicTip";				String _text = "A Clínica é um local administrado por um médico que ajudará a manter seus cidadãos saudáveis. Tamanho: 4x5 quadrados. Custo: 8 toras, 24 madeiras serradas, 32 pedras, 8 vidros, 18 vidrarias, 24 ervas. Atendimento: 20. Emprego: 1 médico. Dicas: Esta é uma versão menor do hospital e funcionará da mesma forma. Aceita apenas 10 pacientes. O design foi feito para caber sob andares multiníveis. Não atrairá ociosos."; }

		{ String _name = "NMT30BathHouse";				String _text = "Casa de Banho"; }
		{ String _name = "NMT30BathHouseLwr";				String _text = "casa de banho"; }
		{ String _name = "NMT30BathHouseTip";				String _text = "A Casa de Banho é um local essencial para higiene que ajuda a manter seus cidadãos saudáveis. Tamanho: 8x6 quadrados. Custo: 24 madeiras serradas, 56 pedras, 24 vidros, 8 cobres, 24 perfumes, 36 ervas. Felicidade: Saúde. Raio: 60. Atendimento: 200. Emprego: 1 trabalhador. Dicas: Esta é uma construção grande com um raio amplo. Fornece felicidade: saúde e atrairá ociosos. O design foi feito para caber sob andares multiníveis."; }

		{ String _name = "NMT30SchoolHouse";				String _text = "Escola Medieval"; }
		{ String _name = "NMT30SchoolHouseLwr";				String _text = "Escola Medieval"; }
		{ String _name = "NMT30SchoolHouseTip";				String _text = "A Escola Medieval é usada para educar os cidadãos e torná-los mais produtivos. Tamanho: 5x5 quadrados. Custo: 48 madeiras serradas, 26 pedras, 12 ferros, 8 cobres, 24 vidros. Atendimento: 40. Emprego: 1 professor. Dicas: Esta é uma construção educacional com o dobro da capacidade de alunos em comparação com a escola regular. A educação é extremamente essencial neste mod. A falta de educação aumenta bastante a dificuldade do jogo."; }

		{ String _name = "RKShopHardware";				String _text = "Matérias-Primas"; }
		{ String _name = "RKShopHardwareLwr";				String _text = "matérias-primas"; }
		{ String _name = "RKShopHardwareTip";				String _text = "A Loja de Matérias-Primas é um pequeno mercado que vende apenas matérias-primas (Madeira, Minerais, Ferro). Tamanho: 4x5 quadrados. Custo: 24 toras, 36 pedras. Vende: (30%) Toras (40%) Minerais (30%) Ferro. Capacidade: 10000 de peso. Emprego: 1-6 vendedores. Dicas: É um bom mercado para abastecer um ferreiro, uma fundição e qualquer construção de produção que use toras, ferro e/ou minerais. Cabe sob andares multiníveis."; }

		{ String _name = "RKShopBuilding";				String _text = "Materiais de Construção"; }
		{ String _name = "RKShopBuildingLwr";				String _text = "materiais de construção"; }
		{ String _name = "RKShopBuildingTip";				String _text = "A Loja de Materiais de Construção é um pequeno mercado que vende apenas materiais de construção de nível 2 (Pedra, Construção: Madeira Serrada, Vidro, Tijolos, Telhas...). Tamanho: 4x5 quadrados. Custo: 24 toras, 36 pedras. Vende: (20%) Pedra (80%) Construção. Capacidade: 10000 de peso. Emprego: 1-6 vendedores. Dicas: É um bom mercado para fornecer materiais de construção a uma área em desenvolvimento. Cabe sob andares multiníveis."; }

		{ String _name = "RKShopGrocery";				String _text = "Mercearia"; }
		{ String _name = "RKShopGroceryLwr";				String _text = "mercearia"; }
		{ String _name = "RKShopGroceryTip";				String _text = "A Mercearia é um pequeno mercado que vende apenas comida (Proteínas, Grãos, Vegetais e Frutas). Tamanho: 4x5 quadrados. Custo: 24 toras, 36 pedras. Vende: Comida (25%) Grãos (25%) Frutas (25%) Vegetais (25%) Proteínas. Capacidade: 10000 de peso. Emprego: 1-6 vendedores. Dicas: É um bom mercado para fornecer comida a um bairro residencial. Vai pegar comida comestível e não comestível. Cabe sob andares multiníveis."; }

		{ String _name = "RKShopDelicate";				String _text = "Suprimentos e Bens"; }
		{ String _name = "RKShopDelicateLwr";				String _text = "suprimentos e bens"; }
		{ String _name = "RKShopDelicateTip";				String _text = "A Loja de Suprimentos e Bens é um pequeno mercado que vende diversos bens variados. Tamanho: 4x5 quadrados. Custo: 24 toras, 36 pedras. Vende: (25%) Ferramentas (25%) Combustível (25%) Roupas (25%) Saúde. Capacidade: 10000 de peso. Emprego: 1-6 vendedores. Dicas: É um bom mercado para fornecer tudo que não é comida a um bairro residencial. Deve fornecer tudo, exceto comida, para toda a sua área residencial. Cabe sob andares multiníveis."; }

		{ String _name = "RKShopFabrics";				String _text = "Tecidos & Cia."; }
		{ String _name = "RKShopFabricsLwr";				String _text = "tecidos & cia."; }
		{ String _name = "RKShopFabricsTip";				String _text = "A Tecidos & Cia. é um pequeno mercado que vende apenas materiais têxteis para confeccionar roupas (Têxteis e Tecidos). Tamanho: 4x5 quadrados. Custo: 24 toras, 36 pedras. Vende: (50%) Têxteis (50%) Tecidos. Capacidade: 10000 de peso. Emprego: 1-6 vendedores. Dicas: É um bom mercado para abastecer alfaiates e tudo que precisa de têxteis. Cabe sob andares multiníveis."; }

		{ String _name = "NewMedievalFlatTool";			String _text = "Ferramenta de Nivelamento"; }
		{ String _name = "NewMedievalFlatToolLwr";		String _text = "ferramenta de nivelamento"; }
		{ String _name = "NewMedievalFlatToolTip";		String _text = "A Ferramenta de Nivelamento serve para nivelar o terreno de volta ao normal após remover uma peça de Canal, uma Lagoa ou uma Mina a céu aberto... Também é muito útil para arrasar colinas. Ela desenhará um X laranja no chão. Assim que a tarefa terminar, você precisará usar a Ferramenta de Remover Construção para se livrar do X laranja."; }

		{ String _name = "NMTMCsandpit";			String _text = "Poço de Areia"; }
		{ String _name = "NMTMCsandpitLWR";			String _text = "poço de areia"; }
		{ String _name = "NMTMCsandpitTip";			String _text = "Um Poço de Areia é uma área de trabalho onde você pode coletar areia. Tamanho: 9x9 quadrados. Custo: 12 toras. Pode Criar: 6-9 de Areia. Capacidade: Ilimitada. Emprego: 1-6 pedreiros. Dicas: Vai criar 6-9 de areia por trabalho concluído. Areia é um material com valor 1. Cuidado para não bloquear a entrada. Por favor, deixe uma estrada na frente."; }

		{ String _name = "NMTMCclaypit";			String _text = "Poço de Argila"; }
		{ String _name = "NMTMCclaypitLWR";			String _text = "poço de argila"; }
		{ String _name = "NMTMCclaypitTip";			String _text = "Um Poço de Argila é uma área de trabalho onde você pode coletar argila. Tamanho: 9x9 quadrados. Custo: 12 toras. Pode Criar: 1-2 de Argila. Capacidade: Ilimitada. Emprego: 1-6 pedreiros. Dicas: Vai criar 1-2 de argila por trabalho concluído. Argila é um material com valor 3. Cuidado para não bloquear a entrada. Por favor, deixe uma estrada na frente."; }

		{ String _name = "NMTMCkiln";				String _text = "Forno de Olaria"; }
		{ String _name = "NMTMCkilnLWR";			String _text = "forno de olaria"; }
		{ String _name = "NMTMCkilnTip";			String _text = "Um forno de olaria é uma área de trabalho onde você pode fazer tijolos e telhas a partir de argila. Tamanho: 6x6 quadrados. Custo: 26 pedras. Pode Produzir: 6-10 de Tijolo (10 de argila) ou 6-10 de Telha (10 de argila). Emprego: 1 trabalhador. Dicas: Também precisa de 2 lenhas por trabalho concluído. Tijolos e telhas são itens de construção com valor 5 cada. Muitas construções exigirão tijolos e telhas como material de construção."; }

		{ String _name = "NMTMCglassmaker";			String _text = "Fabricante de Vidro"; }
		{ String _name = "NMTMCglassmakerLWR";			String _text = "fabricante de vidro"; }
		{ String _name = "NMTMCglassmakerTip";			String _text = "Um Fabricante de Vidro é uma área de trabalho onde você pode fazer vidro e vidraria a partir de areia. Tamanho: 6x6 quadrados. Custo: 38 toras, 32 pedras, 12 ferros. Pode Produzir: 6-8 de Vidro (23 de areia) ou 6-9 de Vidraria (23 de areia). Emprego: 1 trabalhador. Dicas: Também precisa de 6 lenhas ou 3 carvões minerais por trabalho concluído. Vidro é um item de construção com valor 8. Vidraria é um item artesanal com valor 7. Muitas construções exigirão vidro como material de construção. Vidraria é necessária para produção ou material de construção."; }

		{ String _name = "NMT30MCironQuarry";			String _text = "Pedreira de Ferro"; }
		{ String _name = "NMT30MCironQuarryLWR";		String _text = "pedreira de ferro"; }
		{ String _name = "NMT30MCironQuarryTip";		String _text = "Uma Pedreira de Ferro é uma área de trabalho onde você pode extrair Ferro ou Cobre. Tamanho: 10x10 quadrados. Custo: 48 toras. Pode Criar: 2-3 de Minério de Ferro ou 2-3 de Minério de Cobre por trabalho. Capacidade: 2000. Emprego: 1-6 mineiros. Dicas: Minério de Ferro e Minério de Cobre são minerais com valor 4. Você precisará de uma fundição para fundir esses minérios (ferreiros também podem ajudar enquanto você não tem sua fundição). Uma vez esgotada, você pode renová-la 5 vezes."; }

		{ String _name = "NMT30MCrockQuarry";			String _text = "Pedreira de Rocha"; }
		{ String _name = "NMT30MCrockQuarryLWR";		String _text = "pedreira de rocha"; }
		{ String _name = "NMT30MCrockQuarryTip";		String _text = "Uma Pedreira de Rocha é uma área de trabalho onde você pode extrair Pedra, Carvão Mineral ou Sal. Tamanho: 10x10 quadrados. Custo: 48 toras. Pode Criar: 1-2 de Pedra ou 3-4 de Carvão Mineral ou 4-6 de Sal por trabalho. Capacidade: 2000. Emprego: 1-6 mineiros. Dicas: Pedra está sujeita ao seu próprio limite, com valor 8. Carvão Mineral é um mineral com valor 4. E sal é um mineral com valor 1. Uma vez esgotada, você pode renová-la 5 vezes."; }

		{ String _name = "NMT30MCrandomQuarry";			String _text = "Pedreira Aleatória"; }
		{ String _name = "NMT30MCrandomQuarryLWR";		String _text = "pedreira aleatória"; }
		{ String _name = "NMT30MCrandomQuarryTip";		String _text = "Uma Pedreira Aleatória é uma área de trabalho onde você pode extrair de tudo... aleatoriamente. Tamanho: 10x10 quadrados. Custo: 48 toras. Pode Criar aleatoriamente: 1-2 de Pedra, 3-4 de Carvão Mineral, 4-6 de Sal, 2-3 de Minério de Ferro, 2-3 de Minério de Cobre por trabalho. Capacidade: 2000. Emprego: 1-6 mineiros. Dicas: Pedra tem valor 8. Carvão Mineral, Minério de Ferro e Minério de Cobre são minerais com valor 4. E sal é um mineral com valor 1. Uma vez esgotada, você pode renová-la 5 vezes. Esta pedreira aleatória também pode lhe dar 1 Gema (valor 200), 1-2 Minérios de Prata (valor 11) e 1-2 Minérios de Ouro (valor 22). Esses também são minerais."; }

		{ String _name = "NMT30MCironQuarryLvl2";		String _text = "Pedreira de Ferro Nív.2"; }
		{ String _name = "NMT30MCironQuarryLvl2LWR";		String _text = "pedreira de ferro nív.2"; }
		{ String _name = "NMT30MCironQuarryLvl2Tip";		String _text = "Uma Pedreira de Ferro Nív.2 é uma área de trabalho onde você pode extrair Ferro ou Cobre."; }

		{ String _name = "NMT30MCrockQuarryLvl2";		String _text = "Pedreira de Rocha Nív.2"; }
		{ String _name = "NMT30MCrockQuarryLvl2LWR";		String _text = "pedreira de rocha nív.2"; }
		{ String _name = "NMT30MCrockQuarryLvl2Tip";		String _text = "Uma Pedreira de Rocha Nív.2 é uma área de trabalho onde você pode extrair Pedra, Carvão Mineral ou Sal."; }

