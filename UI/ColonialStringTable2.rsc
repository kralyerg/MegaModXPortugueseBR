		{ String _name = "ClothierTip";						String _text = "Um Costureiro é um Alfaiate aprimorado que produz roupas de maior qualidade, mais quentes e de maior valor comercial."; }

		{ String _name = "Silkwormhut";					String _text = "Cabana de Bicho-da-seda"; }
		{ String _name = "SilkwormhutLwr";				String _text = "cabana de bicho-da-seda"; }
		{ String _name = "SilkwormhutTip";				String _text = "Uma Cabana de Bicho-da-seda cria bichos-da-seda para produzir seda e, em último caso, para alimento. Os bichos-da-seda precisam de folhas de amora branca como alimento. Elas podem ser obtidas por comércio ou vindas de um pomar."; }

		{ String _name = "Tobaccobarn";					String _text = "Celeiro de Cura"; }
		{ String _name = "TobaccobarnLwr";				String _text = "celeiro de cura"; }
		{ String _name = "TobaccobarnTip";				String _text = "É aqui que o tabaco é curado ao ar para se transformar em tabaco de cachimbo para fumar. Os produtos finalizados devem ser armazenados em um edifício de Taverna e Jardim"; }

		{ String _name = "CCStatue1";					String _text = "Estátua do Charter"; }
		{ String _name = "CCStatue1Lwr";				String _text = "estátua do charter"; }
		{ String _name = "CCStatue1Tip";				String _text = "Uma estátua representando o governador da colônia."; }
		{ String _name = "Quote1";						String _text = "Pode ser que o propósito da sua vida seja apenas servir de advertência aos outros."; }

