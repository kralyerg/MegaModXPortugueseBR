//buildings

		{ String _name = "StorageBarnStone";				String _text = "Armazém de Estocagem"; }
		{ String _name = "StorageBarnStoneLwr";				String _text = "armazém de estocagem"; }
		{ String _name = "StorageBarnStoneTip";				String _text = "Fornece uma quantidade maior de armazenamento para toda a gama de produtos e recursos."; }
		
		{ String _name = "TradeWarehouse";					String _text = "Depósito de Recursos"; }
		{ String _name = "TradeWarehouseLwr";				String _text = "depósito de recursos"; }
		{ String _name = "TradeWarehouseTip";				String _text = "Armazenamento ajustável para a gama disponível de produtos e recursos. Você deve ter pelo menos 1 unidade de um tipo de produto para que seu botão de armazenamento apareça. Os itens armazenados neste edifício só serão liberados para sua cidade quando você diminuir a quantidade de itens manualmente. Os itens armazenados não ficam livremente disponíveis para as pessoas sem sua intervenção."; }

		{ String _name = "LargeSmithy";						String _text = "Grande Ferraria"; }
		{ String _name = "LargeSmithyLwr";					String _text = "grande ferraria"; }
		{ String _name = "LargeSmithyTip";					String _text = "Uma Grande Ferraria produz itens avançados, incluindo Ferramentas de Aço e Vigas, necessários para alguns edifícios avançados."; }

		{ String _name = "KilnBuilding";					String _text = "Queimador de Pilha"; }
		{ String _name = "KilnBuildingLwr";					String _text = "queimador de pilha"; }
		{ String _name = "KilnBuildingTip";					String _text = "Madeira ou carvão em camadas são empilhados e queimados de dentro para fora, transformando-se em combustível. Uma boa fonte de combustível leve para aquecer casas ou trabalhar."; }
		
		{ String _name = "BrickBuilding";					String _text = "Fábrica de Tijolos"; }
		{ String _name = "BrickBuildingLwr";				String _text = "fábrica de tijolos"; }
		{ String _name = "BrickBuildingTip";				String _text = "Usando um forno, a Fábrica de Tijolos cria tijolos moldados e assados em alta temperatura, necessários para alguns edifícios avançados e para a estrada de tijolos."; }
		
		{ String _name = "Abbey";							String _text = "Abadia"; }
		{ String _name = "AbbeyLwr";						String _text = "abadia"; }
		{ String _name = "AbbeyTip";						String _text = "Uma Abadia abriga monges que colhem frutas silvestres e ervas, e fabricam cerveja. Os monges são autossuficientes e produzem seus itens com ingredientes locais, sem exigir assistência ou entrega de produtos."; }

		{ String _name = "Ropery";							String _text = "Fábrica de Cordas"; }
		{ String _name = "RoperyLwr";						String _text = "fábrica de cordas"; }
		{ String _name = "RoperyTip";						String _text = "Uma Fábrica de Cordas é onde cânhamo e linho são transformados em corda. Fazer corda com cânhamo exige um pouco menos de matéria-prima do que com linho."; }
		
		{ String _name = "Tinyshack";						String _text = "Casebre Minúsculo"; }
		{ String _name = "TinyshackLwr";					String _text = "casebre minúsculo"; }
		{ String _name = "TinyshackTip";					String _text = "Uma moradia pequena e básica que permite que novas famílias cresçam até apenas 3 pessoas. No entanto, uma família já existente de qualquer tamanho pode se mudar para lá se estiver sendo realocada."; }
		
		{ String _name = "Tinyhouse";						String _text = "Casa Minúscula"; }
		{ String _name = "TinyshackLwr";					String _text = "casa minúscula"; }
