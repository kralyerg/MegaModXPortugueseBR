		{ String _name = "CCAdamEve";						String _text = "[CC] Adão e Eva"; }
		{ String _name = "CCAdamEveDesc";					String _text = "Comece com apenas 2 pessoas. Uma pequena quantidade de comida, lenha e roupas é fornecida em uma pequena carroça de armazenamento. Nenhuma estrutura foi construída, nenhuma ferramenta, semente ou animal está disponível inicialmente - você terá que sobreviver e conseguir tudo."; }

		{ String _name = "CCSilkRoad";						String _text = "[CC] Rota da Seda - Fácil"; }
		{ String _name = "CCSilkRoadDesc";					String _text = "Comece com a capacidade de alimentar e colher bichos-da-seda por sua preciosa seda. Começa com seis famílias. Uma grande quantidade de roupas, comida, lenha, materiais de construção e ferramentas é fornecida. Casas e áreas de armazenamento já foram construídas."; }
		
		{ String _name = "CCSilkRoadMed";					String _text = "[CC] Rota da Seda - Média"; }
		{ String _name = "CCSilkRoadMedDesc";					String _text = "Comece com a capacidade de alimentar e colher bichos-da-seda por sua preciosa seda. Começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído."; }
		
		{ String _name = "CCMine";							String _text = "[CC] Mina"; }
		{ String _name = "CCMineDesc";						String _text = "Mineração exclusiva para itens valiosos."; }

		{ String _name = "CCMediumPlus";					String _text = "[CC] Média+"; }
		{ String _name = "CCMediumPlusDesc";					String _text = "Adiciona animais. Um jogo médio+ começa com cinco famílias. Roupas, comida, lenha, ferramentas e materiais de construção são fornecidos. Um celeiro de armazenamento já foi construído. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de animais."; }
		
		{ String _name = "CCMissionary";					String _text = "[CC] Missionário"; }
		{ String _name = "CCMissionaryDesc";					String _text = "Um jogo missionário começa com uma Casa Paroquial e três famílias, 2 delas sem instrução. 2 casas já estão construídas e alguns suprimentos básicos são fornecidos. Uma carroça de armazenamento está disponível. Algumas sementes para campos e pomares estão disponíveis, assim como um rebanho de animais."; }

