		{ String _name = "DSChapelofErnest";			String _text = "Capela de Santo Ernesto"; }
		{ String _name = "DSChapelofErnestLwr";			String _text = "capela de ernesto"; }
		{ String _name = "DSChapelofErnestTip";			String _text = "Construa a Capela de Santo Ernesto; é necessário um Clérigo para realizar os serviços. A capela oferece aos seus cidadãos um lugar para se reunir e adorar, e proporciona felicidade espiritual para até 201 membros - isso inclui também o Clérigo. 7x10 blocos. A construção requer 155 de trabalho de Construção. Apenas uma Capela de Santo Ernesto pode ser construída em um mapa."; }
		
