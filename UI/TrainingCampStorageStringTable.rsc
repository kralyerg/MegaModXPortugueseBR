		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Vocês são os arcos dos quais seus filhos, como flechas vivas, são lançados adiante. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Toda nação tem uma bandeira. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "Ataque é o segredo da defesa; defesa é o planejamento de um ataque. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "Eu não acho que a arquitetura seja apenas sobre abrigo, apenas sobre um recinto muito simples. Ela deveria ser capaz de te empolgar, de te acalmar, de te fazer pensar. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "A raça humana tem uma arma realmente eficaz, e essa arma é o riso. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "A arma mais poderosa da Terra é a alma humana em chamas. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "A não-violência é uma arma poderosa e justa. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Uma vida bem ordenada é como escalar uma torre; a vista na metade do caminho é melhor do que a vista da base, e vai melhorando constantemente à medida que o horizonte se expande. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "Então eu não posso mostrar a vocês exatamente como a saúde é um direito humano básico. Mas o que posso argumentar é que ninguém deveria ter que morrer de uma doença tratável. - Paul Farmer."; }

